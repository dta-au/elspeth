+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createPluginCatalogStore } from "./pluginCatalogStore";
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe("catalog store through the real client decoder", () => {
+  it.each(["correct", "mismatch"])("handles bootstrap header %s with one real client request", async (header) => {
+    const data = { policy: { principal_scope: "local:alice", snapshot_fingerprint: "a", policy_hash: "p",
+      available_plugin_ids: [], capability_groups: [], selections: [], control_modes: [] },
+    sources: [], transforms: [], sinks: [] };
+    const fetch = vi.fn().mockResolvedValue(new Response(JSON.stringify(data), {
+      status: 200, headers: { "X-ELSPETH-Plugin-Snapshot": header === "correct" ? "a" : "b" },
+    }));
+    vi.stubGlobal("fetch", fetch);
+    const store = createPluginCatalogStore();
+    try {
+      await store.getState().load({ principal: "local:alice" });
+      expect(fetch).toHaveBeenCalledTimes(1);
+      expect(fetch).toHaveBeenCalledWith("/api/catalog/bootstrap", expect.objectContaining({ cache: "no-store" }));
+      if (header === "correct") {
+        expect(store.getState()).toMatchObject({ policy: data.policy, sources: [], transforms: [], sinks: [], error: null });
+      } else {
+        expect(store.getState()).toMatchObject({ policy: null, sources: null, transforms: null, sinks: null, key: null });
+        expect(store.getState().error).not.toBeNull();
+      }
+    } finally { store.getState().dispose(); }
+  });
+});
