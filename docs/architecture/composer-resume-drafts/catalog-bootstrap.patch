@@ -0,0 +1,60 @@
+import type { PluginCatalogBootstrapResponse } from "@/types/index";
+
+function object(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function strings(value: unknown): value is string[] {
+  return Array.isArray(value) && value.every((item: unknown) => typeof item === "string");
+}
+
+function exactKeys(value: Record<string, unknown>, keys: string[]): boolean {
+  return Object.keys(value).length === keys.length && keys.every((key) => Object.hasOwn(value, key));
+}
+
+function capability(value: unknown): boolean {
+  return value === "llm" || value === "prompt_shield" || value === "content_safety";
+}
+
+function summaries(value: unknown, kind: string): boolean {
+  return Array.isArray(value) && value.every((item: unknown) => object(item)
+    && typeof item.name === "string" && item.name.length > 0
+    && item.plugin_type === kind && typeof item.description === "string"
+    && Array.isArray(item.config_fields) && item.config_fields.every((field: unknown) => object(field)
+      && typeof field.name === "string" && typeof field.type === "string" && typeof field.required === "boolean"
+      && (field.description === null || typeof field.description === "string") && Object.hasOwn(field, "default"))
+    && [item.usage_when_to_use, item.usage_when_not_to_use, item.example_use].every((text) => text === null || typeof text === "string")
+    && strings(item.capability_tags) && strings(item.audit_characteristics));
+}
+
+/** Validate the new closed bundle envelope without trusting a TypeScript cast. */
+export function decodeCatalogBootstrap(value: unknown, fingerprint: string): PluginCatalogBootstrapResponse {
+  if (!object(value) || !exactKeys(value, ["policy", "sources", "transforms", "sinks"]) || !object(value.policy)) {
+    throw new Error("Malformed plugin catalog bootstrap.");
+  }
+  const policy = value.policy;
+  if (!exactKeys(policy, ["principal_scope", "snapshot_fingerprint", "policy_hash", "available_plugin_ids", "capability_groups", "selections", "control_modes"])
+    || typeof policy.principal_scope !== "string" || policy.principal_scope.length === 0
+    || typeof policy.policy_hash !== "string" || policy.policy_hash.length === 0
+    || policy.snapshot_fingerprint !== fingerprint || fingerprint.length === 0
+    || !strings(policy.available_plugin_ids)
+    || !Array.isArray(policy.capability_groups) || !policy.capability_groups.every((group: unknown) => object(group)
+      && exactKeys(group, ["capability", "available_plugin_ids"]) && capability(group.capability) && strings(group.available_plugin_ids))
+    || !Array.isArray(policy.selections) || !policy.selections.every((selection: unknown) => object(selection)
+      && exactKeys(selection, ["capability", "plugin_id"]) && capability(selection.capability)
+      && (selection.plugin_id === null || typeof selection.plugin_id === "string"))
+    || !Array.isArray(policy.control_modes) || !policy.control_modes.every((mode: unknown) => object(mode)
+      && exactKeys(mode, ["capability", "mode"]) && capability(mode.capability) && (mode.mode === "recommend" || mode.mode === "required"))
+    || !summaries(value.sources, "source") || !summaries(value.transforms, "transform") || !summaries(value.sinks, "sink")) {
+    throw new Error("Malformed plugin catalog bootstrap.");
+  }
+  const admitted = value as unknown as PluginCatalogBootstrapResponse;
+  const ids = [...admitted.sources, ...admitted.transforms, ...admitted.sinks]
+    .map((summary) => `${summary.plugin_type}:${summary.name}`).sort();
+  const available = [...admitted.policy.available_plugin_ids].sort();
+  if (new Set(ids).size !== ids.length || ids.length !== available.length
+    || ids.some((id, index) => id !== available[index])) {
+    throw new Error("Plugin catalog groups do not match their policy.");
+  }
+  return admitted;
+}
