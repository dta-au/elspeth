+"""Authenticated catalog bootstrap parity and live-snapshot custody controls."""
+
+from collections import Counter
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+import httpx
+import pytest
+from pydantic import ValidationError
+
+from elspeth.plugins.infrastructure.manager import get_shared_plugin_manager
+from elspeth.web.app import create_app
+from elspeth.web.async_workers import shutdown_async_workers
+from elspeth.web.auth.local import LocalAuthProvider
+from elspeth.web.catalog.policy_view import PolicyCatalogView
+from elspeth.web.catalog.schemas import PluginCatalogBootstrapResponse
+from elspeth.web.config import WebSettings
+from elspeth.web.key_derivation import derive_binding_generation_key
+from elspeth.web.plugin_policy.availability import RequestPluginSnapshotFactory
+from elspeth.web.plugin_policy.compiler import compile_web_plugin_policy
+from elspeth.web.plugin_policy.profiles import OperatorProfileRegistry, RuntimeWebPluginConfig
+from tests.fixtures.identities import ensure_test_identity, grant_test_pipeline_user
+from tests.fixtures.process_watchdog import OwnedTestProcessWatchdog
+
+ADI = "transform:azure_document_intelligence"
+SECRET_NAME = "AZURE_DOCUMENT_INTELLIGENCE_KEY"
+
+
+@pytest.fixture
+async def bootstrap_app(tmp_path: Path, monkeypatch: pytest.MonkeyPatch):
+    monkeypatch.setenv("ELSPETH_FINGERPRINT_KEY", "catalog-bootstrap-test-fingerprint")
+    settings = WebSettings(
+        data_dir=tmp_path,
+        composer_max_composition_turns=4,
+        composer_max_discovery_turns=4,
+        composer_timeout_seconds=60,
+        composer_rate_limit_per_minute=20,
+        composer_boot_probe_enabled=False,
+        shareable_link_signing_key=b"catalog-bootstrap-test-signing-key",
+        user_secrets_enabled=True,
+        plugin_allowlist=(ADI,),
+        azure_document_intelligence_endpoint="https://bootstrap.cognitiveservices.azure.com",
+        llm_profiles={"task-role": {"provider": "bedrock", "model": "bedrock/anthropic.claude-3-haiku-20240307-v1:0"}},
+        default_llm_profile="task-role",
+    )
+    app = create_app(settings, process_watchdog_factory=OwnedTestProcessWatchdog)
+    app.state.auth_audit_recorder.start()
+    auth = app.state.auth_provider
+    assert isinstance(auth, LocalAuthProvider)
+    tokens = {}
+    for name in ("alice", "bob"):
+        auth.create_user(name, "synthetic catalog test password", name)
+        with app.state.session_engine.begin() as connection:
+            ensure_test_identity(connection, identity_id=name)
+            grant_test_pipeline_user(connection, identity_id=name)
+        tokens[name] = auth._issuer.mint(identity_id=name, username=name)
+    try:
+        async with httpx.AsyncClient(transport=httpx.ASGITransport(app=app), base_url="http://test") as client:
+            yield app, client, tokens
+    finally:
+        app.state.composer_session_cache_registry.begin_shutdown()
+        await app.state.composer_async_worker.stop()
+        app.state.composer_async_worker.assert_shutdown_complete()
+        await shutdown_async_workers()
+        await app.state.composer_session_cache_registry.finish_shutdown()
+        app.state.auth_audit_recorder.close()
+        app.state.session_engine.dispose()
+        await app.state.operator_telemetry.shutdown()
+
+
+@pytest.mark.asyncio
+async def test_authenticated_bundle_matches_old_endpoints_with_live_producer_counts(bootstrap_app):
+    app, client, tokens = bootstrap_app
+    app.state.secret_service.set_user_secret("alice", SECRET_NAME, "synthetic-first", auth_provider_type="local")
+    headers = {"Authorization": f"Bearer {tokens['alice']}"}
+    counts: Counter[str] = Counter()
+    original_snapshot = RequestPluginSnapshotFactory.__call__
+    original_sources = PolicyCatalogView.list_sources
+    original_transforms = PolicyCatalogView.list_transforms
+    original_sinks = PolicyCatalogView.list_sinks
+
+    def snapshot(self, user):
+        counts["snapshots"] += 1
+        return original_snapshot(self, user)
+
+    def sources(self):
+        counts["sources"] += 1
+        return original_sources(self)
+
+    def transforms(self):
+        counts["transforms"] += 1
+        return original_transforms(self)
+
+    def sinks(self):
+        counts["sinks"] += 1
+        return original_sinks(self)
+
+    with (
+        patch.object(RequestPluginSnapshotFactory, "__call__", snapshot),
+        patch.object(PolicyCatalogView, "list_sources", sources),
+        patch.object(PolicyCatalogView, "list_transforms", transforms),
+        patch.object(PolicyCatalogView, "list_sinks", sinks),
+    ):
+        bundled = await client.get("/api/catalog/bootstrap", headers=headers)
+        assert bundled.status_code == 200
+        assert counts == {"snapshots": 1, "sources": 1, "transforms": 1, "sinks": 1}
+        counts.clear()
+        prior = {}
+        for group in ("policy", "sources", "transforms", "sinks"):
+            response = await client.get(f"/api/catalog/{group}", headers=headers)
+            assert response.status_code == 200
+            prior[group] = response.json()
+        # Old path is the connected positive counter control, not guessed calls.
+        assert counts == {"snapshots": 4, "sources": 2, "transforms": 2, "sinks": 2}
+    assert bundled.json() == prior
+    assert bundled.headers["cache-control"] == "private, no-store"
+    assert bundled.headers["vary"] == "Authorization, Cookie"
+    assert bundled.headers["x-elspeth-plugin-snapshot"] == prior["policy"]["snapshot_fingerprint"]
+    assert ADI in prior["policy"]["available_plugin_ids"]
+    adi = next(item for item in prior["transforms"] if item["name"] == "azure_document_intelligence")
+    assert not next(field for field in adi["config_fields"] if field["name"] == "endpoint")["required"]
+    llm = next(item for item in prior["transforms"] if item["name"] == "llm")
+    assert "api_key" not in {field["name"] for field in llm["config_fields"]}
+    assert "synthetic-first" not in bundled.text
+
+
+@pytest.mark.asyncio
+async def test_fresh_authentication_principal_inventory_and_generation(bootstrap_app):
+    app, client, tokens = bootstrap_app
+    assert (await client.get("/api/catalog/bootstrap")).status_code == 401
+    headers = {name: {"Authorization": f"Bearer {token}"} for name, token in tokens.items()}
+    before = await client.get("/api/catalog/bootstrap", headers=headers["alice"])
+    assert ADI not in before.json()["policy"]["available_plugin_ids"]
+    app.state.secret_service.set_user_secret("alice", SECRET_NAME, "synthetic-first", auth_provider_type="local")
+    alice = await client.get("/api/catalog/bootstrap", headers=headers["alice"])
+    bob = await client.get("/api/catalog/bootstrap", headers=headers["bob"])
+    assert alice.status_code == bob.status_code == 200
+    assert alice.json()["policy"]["principal_scope"] == "local:alice"
+    assert bob.json()["policy"]["principal_scope"] == "local:bob"
+    assert ADI in alice.json()["policy"]["available_plugin_ids"]
+    assert ADI not in bob.json()["policy"]["available_plugin_ids"]
+    assert all(item["name"] != "azure_document_intelligence" for item in bob.json()["transforms"])
+    app.state.secret_service.set_user_secret("alice", SECRET_NAME, "synthetic-rotated", auth_provider_type="local")
+    rotated = await client.get("/api/catalog/bootstrap", headers=headers["alice"])
+    assert rotated.headers["x-elspeth-plugin-snapshot"] != alice.headers["x-elspeth-plugin-snapshot"]
+    assert rotated.json()["policy"]["available_plugin_ids"] == alice.json()["policy"]["available_plugin_ids"]
+    assert "synthetic-rotated" not in rotated.text
+    app.state.secret_service.delete_user_secret("alice", SECRET_NAME, auth_provider_type="local")
+    deleted = await client.get("/api/catalog/bootstrap", headers=headers["alice"])
+    assert ADI not in deleted.json()["policy"]["available_plugin_ids"]
+
+
+@pytest.mark.asyncio
+async def test_bootstrap_wire_contract_is_closed_and_response_mutation_is_not_retained(bootstrap_app):
+    _, client, tokens = bootstrap_app
+    headers = {"Authorization": f"Bearer {tokens['alice']}"}
+    response = await client.get("/api/catalog/bootstrap", headers=headers)
+    PluginCatalogBootstrapResponse.model_validate_json(response.content)
+    bad = response.json()
+    bad["resolved_credentials"] = {}
+    with pytest.raises(ValidationError, match="extra_forbidden"):
+        PluginCatalogBootstrapResponse.model_validate_json(json.dumps(bad))
+    changed = response.json()
+    changed["sources"][0]["description"] = "client mutation"
+    next_response = await client.get("/api/catalog/bootstrap", headers=headers)
+    assert next_response.json() == response.json()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("change", ["endpoint", "profile", "policy"])
+async def test_new_request_uses_current_configured_snapshot_and_public_projection(bootstrap_app, change):
+    app, client, tokens = bootstrap_app
+    app.state.secret_service.set_user_secret("alice", SECRET_NAME, "synthetic-first", auth_provider_type="local")
+    headers = {"Authorization": f"Bearer {tokens['alice']}"}
+    before = await client.get("/api/catalog/bootstrap", headers=headers)
+    values = app.state.settings.model_dump()
+    if change == "endpoint":
+        values["azure_document_intelligence_endpoint"] = None
+    elif change == "profile":
+        values["llm_profiles"] = {"new-role": {"provider": "bedrock", "model": "bedrock/anthropic.claude-3-haiku-20240307-v1:0"}}
+        values["default_llm_profile"] = "new-role"
+    else:
+        values["plugin_allowlist"] = ()
+    settings = WebSettings.model_validate(values)
+    runtime = RuntimeWebPluginConfig.from_settings(settings)
+    policy = compile_web_plugin_policy(registry=get_shared_plugin_manager(), settings=runtime)
+    profiles = OperatorProfileRegistry(policy=policy, settings=runtime)
+    # Model a replacement of the owned configured services, not an ambient
+    # mutation of the request snapshot or a fake permission verdict.
+    app.state.web_plugin_policy = policy
+    app.state.operator_profile_registry = profiles
+    app.state.plugin_snapshot_factory = RequestPluginSnapshotFactory(
+        policy=policy, catalog=app.state.catalog_service, profiles=profiles,
+        auth_provider=settings.auth_provider, secret_service=app.state.secret_service,
+        server_store=app.state.server_secret_store, user_store=app.state.user_secret_store,
+        generation_key=derive_binding_generation_key(settings.secret_key),
+    )
+    after = await client.get("/api/catalog/bootstrap", headers=headers)
+    assert before.status_code == after.status_code == 200
+    assert before.headers["x-elspeth-plugin-snapshot"] != after.headers["x-elspeth-plugin-snapshot"]
+    assert before.json()["transforms"] != after.json()["transforms"]
+    for group in ("policy", "sources", "transforms", "sinks"):
+        separate = await client.get(f"/api/catalog/{group}", headers=headers)
+        assert separate.status_code == 200
+        assert after.json()[group] == separate.json()
+    assert "synthetic-first" not in after.text
