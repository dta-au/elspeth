+    assert result.returncode == 0 and result.stdout == b"", result.stderr.decode()
+    assert json.loads((tmp_path / "channel-loss.json").read_text()) == {
+        "supervisor_returncode": -signal.SIGKILL,
+        "runner_returncode": 70,
