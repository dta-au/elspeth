--- /dev/null
+++ b/src/elspeth/composer_mcp/standalone.py
@@ -0,0 +1,78 @@
+"""Actual standalone root, executor ownership and truthful completion."""
+
+from __future__ import annotations
+
+import asyncio
+import threading
+from collections.abc import Awaitable, Callable
+from pathlib import Path
+
+from elspeth.composer_mcp.portable_control import PortableProcessWatchdog
+from elspeth.composer_mcp.server import run_server
+from elspeth.contracts.process_watchdog_wire import ProcessCompletionWitness
+from elspeth.web.async_workers import configure_standalone_executor_recovery, shutdown_async_workers
+from elspeth.web.dependencies import create_catalog_service
+from elspeth.web.execution.runtime_preflight import RuntimePreflightCoordinator
+from elspeth.web.process_recovery import ProcessRecovery
+
+
+async def run_standalone(watchdog: PortableProcessWatchdog, draining: threading.Event, scratch_dir: Path, data_dir: Path) -> None:
+    """Own exactly this process's serving root; never adopt a host registration."""
+    root = asyncio.current_task()
+    assert root is not None
+    watchdog.bind_root_task(root)
+    recovery = ProcessRecovery(watchdog=watchdog, instance_draining=draining)
+    recovery.start_monitor()
+    coordinator = RuntimePreflightCoordinator()
+    owned = False
+    originals: list[BaseException] = []
+    cleanup_failed = False
+    try:
+        configure_standalone_executor_recovery(
+            drain_seconds=10.0,
+            instance_draining=draining,
+            generation_unavailable=threading.Event(),
+            recovery_callback=recovery.required_generation_expired,
+        )
+        owned = True
+        catalog = create_catalog_service()
+        await run_server(catalog, scratch_dir, data_dir, runtime_preflight_coordinator=coordinator)
+    except BaseException as original:
+        originals.append(original)
+    finally:
+        # The independent grace is armed before any possibly blocked join.
+        recovery.begin_shutdown()
+
+        async def settle(action: Callable[[], Awaitable[None]]) -> None:
+            nonlocal cleanup_failed
+            # Retain each action across repeated cancellation, then continue to
+            # later actions. Cancellation is an outcome, never proof of a join.
+            task = asyncio.ensure_future(action())
+            while not task.done():
+                try:
+                    await asyncio.shield(task)
+                except asyncio.CancelledError as cancellation:
+                    originals.append(cancellation)
+                except BaseException:
+                    break
+            try:
+                task.result()
+            except BaseException as failure:
+                cleanup_failed = True
+                originals.append(failure)
+
+        await settle(recovery.join_escalation)
+        await settle(coordinator.seal_and_join)
+        if owned:
+            await settle(shutdown_async_workers)
+        # A failed join cannot issue the nominal completion assertion. An
+        # unresolved join remains awaited under the independent deadline.
+        if owned and not cleanup_failed:
+            await settle(lambda: watchdog.complete(ProcessCompletionWitness(watchdog.target)))
+            if not cleanup_failed:
+                await settle(recovery.join_monitor_after_completion)
+
+    if len(originals) == 1:
+        raise originals[0]
+    if originals:
+        raise BaseExceptionGroup("Composer serving and cleanup outcomes", originals)
diff --git a/tests/helpers/composer_lifecycle_probe.py b/tests/helpers/composer_lifecycle_probe.py
new file mode 100644
index 000000000..948acfac1
--- /dev/null
+++ b/tests/helpers/composer_lifecycle_probe.py
@@ -0,0 +1,239 @@
+"""Precise faults around the actual standalone lifecycle and supervisor."""
+
+from __future__ import annotations
+
+import json
+import os
+import sys
+from pathlib import Path
+
+
+async def embedded_calls(directory: Path, coordinator):
+    from mcp.types import CallToolRequest, CallToolRequestParams
+
+    from elspeth.composer_mcp.server import _build_stdio_server
+    from elspeth.web.dependencies import create_catalog_service
+
+    server = _build_stdio_server(
+        create_catalog_service(), directory / "scratch", directory / "data", runtime_preflight_coordinator=coordinator
+    )
+
+    async def call(name, arguments):
+        response = await server.request_handlers[CallToolRequest](
+            CallToolRequest(method="tools/call", params=CallToolRequestParams(name=name, arguments=arguments))
+        )
+        result = response.root
+        return {"transport_error": result.content[0].text} if result.isError else json.loads(result.content[0].text)
+
+    source = await call(
+        "set_source",
+        {"plugin": "null", "on_success": "result", "options": {"schema": {"mode": "observed"}}, "on_validation_failure": "discard"},
+    )
+    output = await call(
+        "set_output",
+        {
+            "sink_name": "result",
+            "plugin": "csv",
+            "options": {"path": "output.csv", "schema": {"mode": "observed"}, "mode": "write", "collision_policy": "auto_increment"},
+            "on_write_failure": "discard",
+        },
+    )
+    assert source["success"] and output["success"]
+    return await call("preview_pipeline", {})
+
+
+def embedded_without_owner(directory: Path) -> None:
+    import asyncio
+
+    from elspeth.web import async_workers
+    from elspeth.web.execution.runtime_preflight import RuntimePreflightCoordinator
+
+    async def run():
+        assert async_workers._RECOVERY_CALLBACK is None
+        coordinator = RuntimePreflightCoordinator()
+        preview = await embedded_calls(directory, coordinator)
+        assert preview == {"transport_error": "Tool error: AuditIntegrityError"}, preview
+        assert async_workers._RECOVERY_CALLBACK is None and async_workers._SHARED_EXECUTOR is None
+        await coordinator.seal_and_join()
+        (directory / "embedded.json").write_text(json.dumps(preview))
+
+    asyncio.run(run())
+
+
+def child(directory: Path, mode: str) -> None:
+    from elspeth.composer_mcp.runner import _authenticate_supervisor
+
+    assert "elspeth.contracts" not in sys.modules
+    assert "elspeth.composer_mcp.server" not in sys.modules
+    nonce = os.environ["_ELSPETH_COMPOSER_CONTROL_NONCE"]
+    connection = _authenticate_supervisor()
+    assert "elspeth.contracts" not in sys.modules
+    assert "elspeth.composer_mcp.server" not in sys.modules
+    assert not any(name.startswith("elspeth.plugins") for name in sys.modules)
+    assert "_ELSPETH_COMPOSER_CONTROL_NONCE" not in os.environ
+    assert "_ELSPETH_COMPOSER_CONTROL_PORT" not in os.environ
+    wire = sys.modules["elspeth.contracts.process_watchdog_wire"]
+
+    import asyncio
+    import subprocess
+    import threading
+    import time
+    from contextlib import asynccontextmanager
+
+    from elspeth.composer_mcp import server, standalone
+    from elspeth.composer_mcp.portable_control import PortableProcessWatchdog
+    from elspeth.contracts import process_watchdog_wire
+    from elspeth.web import async_workers
+
+    descendant = subprocess.check_output([sys.executable, "-c", "import json, os; print(json.dumps(dict(os.environ)))"])
+    assert nonce.encode() not in descendant
+    assert b"_ELSPETH_COMPOSER_CONTROL_" not in descendant
+
+    assert wire is process_watchdog_wire
+    assert wire.ProcessWatchdogTarget is process_watchdog_wire.ProcessWatchdogTarget
+    assert wire.ProcessCompletionWitness is process_watchdog_wire.ProcessCompletionWitness
+    (directory / "authenticated.json").write_text(
+        json.dumps({"pid": os.getpid(), "canonical_wire": True, "bootstrap_consumed": True, "descendant_bootstrap_absent": True})
+    )
+    draining = threading.Event()
+    watchdog = PortableProcessWatchdog(connection, draining)
+    begin = watchdog.begin_recovery
+    complete = watchdog.complete
+
+    async def observed_begin(reason):
+        receipt = await begin(reason)
+        (directory / "draining.json").write_text(json.dumps({"admissions": async_workers.outstanding_admissions()}))
+        return receipt
+
+    async def observed_complete(witness):
+        assert async_workers.outstanding_admissions() == 0
+        assert not async_workers._RECOVERING_GENERATIONS
+        assert async_workers._SHARED_EXECUTOR is None
+        (directory / "completion").write_text("settled")
+        await complete(witness)
+
+    watchdog.begin_recovery = observed_begin
+    watchdog.complete = observed_complete
+    if mode.startswith("blocked"):
+        validate = server.validate_pipeline
+
+        def held_validation(*args, **kwargs):
+            (directory / "worker").write_text("entered")
+            while not (directory / "release").exists():
+                time.sleep(0.01)
+            return validate(*args, **kwargs)
+
+        server.validate_pipeline = held_validation
+    if mode == "quarantine":
+        from concurrent.futures import ThreadPoolExecutor
+
+        from elspeth.web.process_recovery import ProcessRecovery
+
+        catalog_factory = standalone.create_catalog_service
+        expired = ProcessRecovery.required_generation_expired
+
+        def observed_expiry(recovery, observation):
+            expired(recovery, observation)
+            (directory / "expired").write_text("actual required generation expiry")
+
+        ProcessRecovery.required_generation_expired = observed_expiry
+
+        class QueueThenRaiseExecutor(ThreadPoolExecutor):
+            def submit(self, fn, /, *args, **kwargs):
+                super().submit(fn, *args, **kwargs)
+                (directory / "worker").write_text("actual queued submission fault")
+                raise RuntimeError("submit failed after queueing")
+
+        def quarantining_catalog():
+            catalog = catalog_factory()
+            executor = QueueThenRaiseExecutor(max_workers=1)
+
+            def physical_blocker():
+                while not (directory / "release").exists():
+                    time.sleep(0.01)
+
+            ThreadPoolExecutor.submit(executor, physical_blocker)
+            async_workers._SHARED_EXECUTOR = executor
+            return catalog
+
+        standalone.create_catalog_service = quarantining_catalog
+    if mode == "startup-failure":
+
+        def failed_catalog():
+            raise LookupError("startup fault")
+
+        standalone.create_catalog_service = failed_catalog
+    if mode in ("transport-failure", "cleanup-failure"):
+        transport = server.stdio_server
+
+        @asynccontextmanager
+        async def failing_transport():
+            async with transport() as streams:
+                yield streams
+            raise OSError("transport fault")
+
+        server.stdio_server = failing_transport
+    if mode == "cleanup-failure":
+        shutdown = standalone.shutdown_async_workers
+
+        async def failed_shutdown():
+            await shutdown()
+            (directory / "workers-joined").write_text("settled")
+            raise ArithmeticError("cleanup fault")
+
+        standalone.shutdown_async_workers = failed_shutdown
+
+    async def run():
+        try:
+            if mode == "embedded-owned":
+                from elspeth.contracts.process_watchdog_wire import ProcessCompletionWitness
+                from elspeth.web.execution.runtime_preflight import RuntimePreflightCoordinator
+                from elspeth.web.process_recovery import ProcessRecovery
+
+                root = asyncio.current_task()
+                assert root is not None
+                watchdog.bind_root_task(root)
+                recovery = ProcessRecovery(watchdog=watchdog, instance_draining=draining)
+                recovery.start_monitor()
+                unavailable = threading.Event()
+                callback = recovery.required_generation_expired
+                async_workers.configure_required_executor_recovery(
+                    drain_seconds=10, instance_draining=draining, generation_unavailable=unavailable, recovery_callback=callback
+                )
+                coordinator = RuntimePreflightCoordinator()
+                preview = await embedded_calls(directory, coordinator)
+                assert preview["data"]["preview_is_valid"], preview
+                assert async_workers._RECOVERY_CALLBACK is callback
+                assert async_workers._INSTANCE_DRAINING is draining and not draining.is_set()
+                assert async_workers._GENERATION_UNAVAILABLE is unavailable
+                assert async_workers._SHARED_EXECUTOR is not None
+                assert not async_workers._SHARED_SHUTDOWN_STARTED and not coordinator._sealed
+                (directory / "embedded.json").write_text(
+                    json.dumps({"preview_valid": True, "host_owner_preserved": True, "host_coordinator_open": True})
+                )
+                recovery.begin_shutdown()
+                await recovery.join_escalation()
+                await coordinator.seal_and_join()
+                await async_workers.shutdown_async_workers()
+                await watchdog.complete(ProcessCompletionWitness(watchdog.target))
+                await recovery.join_monitor_after_completion()
+            else:
+                await standalone.run_standalone(watchdog, draining, directory / "scratch", directory / "data")
+        except BaseException as error:
+
+            def classes(exc):
+                if isinstance(exc, BaseExceptionGroup):
+                    return [item for child_error in exc.exceptions for item in classes(child_error)]
+                return [type(exc).__name__]
+
+            (directory / "outcomes.json").write_text(json.dumps(classes(error)))
+            raise
+
+    asyncio.run(run())
+
+
+if __name__ == "__main__":
+    if sys.argv[2] == "embedded-unowned":
+        embedded_without_owner(Path(sys.argv[1]))
+    else:
+        child(Path(sys.argv[1]), sys.argv[2])
diff --git a/tests/helpers/composer_parent_death_probe.py b/tests/helpers/composer_parent_death_probe.py
new file mode 100644
index 000000000..d3ecd4cf9
--- /dev/null
+++ b/tests/helpers/composer_parent_death_probe.py
@@ -0,0 +1,143 @@
+"""Isolated Linux subreaper observes only this test's retained descendants."""
+
+from __future__ import annotations
+
+import asyncio
+import ctypes
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+from unittest.mock import patch
+
+from composer_stdio_probe import linux_owned_children
+from mcp import ClientSession, StdioServerParameters
+from mcp.client import stdio
+
+
+async def controller(directory: Path, *, channel_loss: bool) -> None:
+    processes = []
+    create = stdio._create_platform_compatible_process
+
+    async def observe(*args, **kwargs):
+        process = await create(*args, **kwargs)
+        processes.append(process)
+        return process
+
+    parameters = StdioServerParameters(
+        command=str(Path(sys.executable).parent / "elspeth-composer"),
+        args=["--scratch-dir", str(directory / "scratch"), "--data-dir", str(directory / "data")],
+        env=dict(os.environ),
+    )
+    with (directory / "runner-stderr.log").open("w") as errors, patch.object(stdio, "_create_platform_compatible_process", observe):
+        async with stdio.stdio_client(parameters, errlog=errors) as streams, ClientSession(*streams) as session:
+            await session.initialize()
+            supervisor = processes[0].pid
+            children = linux_owned_children(supervisor)
+            assert len(children) == 1
+            (directory / "ready.json").write_text(json.dumps({"supervisor": supervisor, "runner": children[0]}))
+            if channel_loss:
+                while not (directory / "kill-supervisor").exists():
+                    await asyncio.sleep(0.01)
+                processes[0].kill()  # Exact SDK-owned process handle.
+                assert await processes[0].wait() == -signal.SIGKILL
+                (directory / "supervisor-killed").write_text("observed and reaped")
+            else:
+                await asyncio.Event().wait()
+
+
+def subreaper(directory: Path, *, channel_loss: bool) -> None:
+    # This state affects only this isolated harness. No competing wildcard
+    # reaper, parent pytest syscall, or PID-discovered signal target is used.
+    libc = ctypes.CDLL(None, use_errno=True)
+    assert libc.prctl(36, 1, 0, 0, 0) == 0  # PR_SET_CHILD_SUBREAPER
+    signal.signal(signal.SIGCHLD, signal.SIG_DFL)
+    owned = None
+    with (directory / "controller-stderr.log").open("w") as errors:
+        process = subprocess.Popen(
+            [sys.executable, str(Path(__file__)), "controller-loss" if channel_loss else "controller", str(directory)],
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.DEVNULL,
+            stderr=errors,
+        )
+        try:
+            deadline = time.monotonic() + 12
+            while not (directory / "ready.json").exists():
+                assert process.poll() is None, "controller exited before public initialization"
+                if time.monotonic() >= deadline:
+                    raise TimeoutError("controller startup expired")
+                time.sleep(0.01)
+            owned = json.loads((directory / "ready.json").read_text())
+            if channel_loss:
+                (directory / "kill-supervisor").write_text("kill exact controller-owned supervisor")
+                deadline = time.monotonic() + 12
+                while not (directory / "supervisor-killed").exists():
+                    if time.monotonic() >= deadline:
+                        raise TimeoutError("controller did not reap its killed supervisor")
+                    time.sleep(0.01)
+                target = owned["runner"]
+            else:
+                process.kill()  # Exact retained Popen, deliberately uncatchable.
+                assert process.wait(timeout=5) == -signal.SIGKILL
+                target = owned["supervisor"]
+            deadline = time.monotonic() + 12
+            while True:
+                # The reaped parent exit transfers this exact descendant to
+                # the subreaper. waitpid confirms actual child custody.
+                observed, status = os.waitpid(target, os.WNOHANG)
+                if observed:
+                    break
+                if time.monotonic() >= deadline:
+                    raise TimeoutError("public supervisor did not settle on controller death")
+                time.sleep(0.01)
+            if channel_loss:
+                assert os.waitstatus_to_exitcode(status) == 70
+                assert process.wait(timeout=5) == 0
+                (directory / "channel-loss.json").write_text(
+                    json.dumps(
+                        {
+                            "supervisor_returncode": -signal.SIGKILL,
+                            "runner_returncode": 70,
+                            "runner_reaped_by_subreaper": True,
+                            "controller_returncode": 0,
+                        }
+                    )
+                )
+            else:
+                assert os.waitstatus_to_exitcode(status) == 1
+                assert not Path(f"/proc/{owned['runner']}").exists(), "real supervisor must reap its runner"
+                (directory / "parent-death.json").write_text(
+                    json.dumps(
+                        {
+                            "controller_returncode": process.returncode,
+                            "supervisor_returncode": os.waitstatus_to_exitcode(status),
+                            "supervisor_reaped": True,
+                            "runner_reaped_by_supervisor": True,
+                        }
+                    )
+                )
+        finally:
+            if process.poll() is None:
+                process.kill()
+                process.wait(timeout=5)
+            if owned is not None:
+                for pid in (owned["supervisor"], owned["runner"]):
+                    try:
+                        observed, _ = os.waitpid(pid, os.WNOHANG)
+                    except ChildProcessError:
+                        continue
+                    if not observed:
+                        # A zero wait result proves an unreaped owned child;
+                        # only this harness can reap it or signal it now.
+                        os.kill(pid, signal.SIGKILL)
+                        os.waitpid(pid, 0)
+
+
+if __name__ == "__main__":
+    if sys.argv[1].startswith("controller"):
+        asyncio.run(controller(Path(sys.argv[2]), channel_loss=sys.argv[1] == "controller-loss"))
+    else:
+        subreaper(Path(sys.argv[2]), channel_loss=sys.argv[1] == "subreaper-channel-loss")
diff --git a/tests/helpers/composer_stdio_ownership_probe.py b/tests/helpers/composer_stdio_ownership_probe.py
new file mode 100644
index 000000000..701948c19
--- /dev/null
+++ b/tests/helpers/composer_stdio_ownership_probe.py
@@ -0,0 +1,128 @@
+"""Observe actual stdio pipe ownership through the dedicated production owner."""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import threading
+import time
+from contextlib import suppress
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def runner(directory: Path) -> None:
+    from elspeth.composer_mcp.runner import _authenticate_supervisor
+
+    connection = _authenticate_supervisor()
+
+    from elspeth.composer_mcp.portable_control import PortableProcessWatchdog
+    from elspeth.contracts.process_watchdog_wire import BootstrapCompletionWitness
+
+    owner = PortableProcessWatchdog(connection, threading.Event())
+    token = b""
+    while len(token) < 4:
+        chunk = os.read(0, 4 - len(token))
+        if not chunk:
+            raise RuntimeError("Inherited runner input closed before positive control")
+        token += chunk
+    assert token == b"ping"
+    os.write(1, b"pong")
+    os.write(2, b"runner-inherited-stderr\n")
+    # These are the runner's own copies. Keep its authenticated connection and
+    # process alive after releasing both transport ends.
+    sys.stdin.close()
+    sys.stdout.close()
+    os.close(0)
+    os.close(1)
+    (directory / "runner-closed.json").write_text(json.dumps({"pid": os.getpid()}))
+    deadline = time.monotonic() + 12
+    while not (directory / "release").exists():
+        if time.monotonic() >= deadline:
+            raise TimeoutError("Outer stdio ownership probe did not release runner")
+        time.sleep(0.01)
+    os.write(2, b"runner-stderr-after-transport-close\n")
+    owner.complete_bootstrap(BootstrapCompletionWitness(owner.target))
+
+
+def probe(directory: Path) -> None:
+    command = [
+        sys.executable,
+        str(ROOT / "src/elspeth/composer_mcp/portable_supervisor.py"),
+        sys.executable,
+        str(Path(__file__)),
+        "runner",
+        str(directory),
+    ]
+    with (directory / "stderr.log").open("wb") as errors:
+        process = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=errors)
+        assert process.stdin is not None and process.stdout is not None
+        echoed = threading.Event()
+        eof = threading.Event()
+        output: list[bytes] = []
+
+        def read_output() -> None:
+            output.append(process.stdout.read(4))
+            echoed.set()
+            output.append(process.stdout.read(1))
+            eof.set()
+
+        reader = threading.Thread(target=read_output, name="owned-stdio-probe-reader", daemon=True)
+        reader.start()
+        try:
+            process.stdin.write(b"ping")
+            process.stdin.flush()
+            deadline = time.monotonic() + 10
+            while not (directory / "runner-closed.json").exists():
+                assert process.poll() is None, "supervisor exited before ownership observation"
+                if time.monotonic() >= deadline:
+                    raise TimeoutError("Runner did not close inherited transport")
+                time.sleep(0.01)
+            assert echoed.wait(1) and output[0] == b"pong"
+            before = process.poll()
+            output_eof = eof.wait(0.5) and output[1] == b""
+            try:
+                os.write(process.stdin.fileno(), b"reader-probe")
+            except BrokenPipeError:
+                input_reader_gone = True
+            else:
+                input_reader_gone = False
+            after = process.poll()
+            observation = {
+                "supervisor_alive_before": before is None,
+                "supervisor_alive_after": after is None,
+                "stdout_eof_while_alive": output_eof,
+                "stdin_reader_gone_while_alive": input_reader_gone,
+                "inherited_echo": output[0].decode(),
+            }
+            (directory / "observation.json").write_text(json.dumps(observation, indent=2))
+            assert observation == {
+                "supervisor_alive_before": True,
+                "supervisor_alive_after": True,
+                "stdout_eof_while_alive": True,
+                "stdin_reader_gone_while_alive": True,
+                "inherited_echo": "pong",
+            }, observation
+        finally:
+            (directory / "release").write_text("settle the exact owned runner")
+            # Closing a buffered writer after the successful loss-of-reader
+            # observation can itself report the same expected broken pipe.
+            with suppress(BrokenPipeError):
+                process.stdin.close()
+            status = process.wait(timeout=8)
+            reader.join(timeout=2)
+            assert not reader.is_alive()
+            process.stdout.close()
+            (directory / "status.json").write_text(json.dumps({"returncode": status}))
+            assert status == 0
+        assert (directory / "stderr.log").read_bytes() == b"runner-inherited-stderr\nrunner-stderr-after-transport-close\n"
+
+
+if __name__ == "__main__":
+    if sys.argv[1] == "runner":
+        runner(Path(sys.argv[2]))
+    else:
+        probe(Path(sys.argv[2]))
