                    and "trigger" in candidate_arguments
                    and candidate_arguments["trigger"] == ADVISOR_TRIGGER_CANNOT_COMPLETE
                ):
                    mixed_abandonment_batch = True
                    break
        if ctx.turn_evidence is not None:
            ctx.turn_evidence.invalidate_abandonment()
