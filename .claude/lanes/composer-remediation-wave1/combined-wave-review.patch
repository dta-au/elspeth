+    def unexpected_recovery(observation: object) -> None:
+        raise AssertionError(observation)
+
+    async def main() -> None:
+        configure_required_executor_recovery(
+            drain_seconds=10,
+            instance_draining=threading.Event(),
+            generation_unavailable=threading.Event(),
