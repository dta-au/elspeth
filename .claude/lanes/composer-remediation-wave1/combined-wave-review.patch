index 000000000..36daf7a48
--- /dev/null
+++ b/tests/helpers/composer_stdio_probe.py
@@ -0,0 +1,187 @@
+"""Fresh public SDK client; no application imports or child recovery injection."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import sys
+from pathlib import Path
+from unittest.mock import patch
+
+from mcp import ClientSession, StdioServerParameters
+from mcp.client import stdio
+
+
+def linux_owned_children(parent_pid: int) -> list[int]:
+    """Measure direct children using PPid; this kernel omits task/children."""
+    children = []
+    for entry in Path("/proc").iterdir():
+        if not entry.name.isdecimal():
+            continue
+        try:
+            status = (entry / "status").read_text()
+        except (FileNotFoundError, ProcessLookupError):
+            continue
+        parent = next(line.split()[1] for line in status.splitlines() if line.startswith("PPid:"))
+        if int(parent) == parent_pid:
+            children.append(int(entry.name))
+    return sorted(children)
+
+
+async def probe(directory: Path) -> dict:
+    directory.mkdir(parents=True, exist_ok=True)
+    root = directory / "data"
+    root.mkdir(exist_ok=True)
+    (root / "input.csv").write_text("text\nhello\n")
+    processes = []
+    create = stdio._create_platform_compatible_process
+
+    async def observe(*args, **kwargs):
+        process = await create(*args, **kwargs)
+        processes.append(process)
+        return process
+
+    receipt = {}
+    parameters = StdioServerParameters(
+        command=str(Path(sys.executable).parent / "elspeth-composer"),
+        args=["--scratch-dir", str(directory / "scratch"), "--data-dir", str(root)],
+        env=dict(os.environ),
+    )
+    with (directory / "stderr.log").open("w") as errors, patch.object(stdio, "_create_platform_compatible_process", observe):
+        async with stdio.stdio_client(parameters, errlog=errors) as streams, ClientSession(*streams) as session:
+            await session.initialize()
+            if sys.platform == "linux":
+                launcher = processes[0].pid
+                children = linux_owned_children(launcher)
+                assert len(children) == 1, children
+                receipt["topology"] = {"supervisor": launcher, "runner": int(children[0])}
+
+            async def call(name, arguments):
+                result = await session.call_tool(name, arguments)
+                assert len(result.content) == 1
+                return json.loads(result.content[0].text) if not result.isError else {"transport_error": result.content[0].text}
+
+            receipt["new"] = await call("new_session", {})
+            source = {
+                "plugin": "null",
+                "on_success": "result",
+                "options": {"schema": {"mode": "observed"}},
+                "on_validation_failure": "discard",
+            }
+            output = {
+                "sink_name": "result",
+                "plugin": "csv",
+                "options": {"path": "output.csv", "schema": {"mode": "observed"}, "mode": "write", "collision_policy": "auto_increment"},
+                "on_write_failure": "discard",
+            }
+            receipt["source"] = await call("set_source", source)
+            receipt["output"] = await call("set_output", output)
+            receipt["preview"] = await call("preview_pipeline", {})
+            if "transport_error" not in receipt["preview"]:
+                source.update(plugin="csv", options={"path": "input.csv", "schema": {"mode": "observed"}})
+                receipt["file_source"] = await call("set_source", source)
+                for form in ("source", "sources"):
+                    pipeline = {form: source if form == "source" else {"orders": source}, "nodes": [], "edges": [], "outputs": [output]}
+                    receipt[form + "_pipeline"] = await call("set_pipeline", pipeline)
+                    receipt[form + "_preview"] = await call("preview_pipeline", {})
+                    assert receipt[form + "_pipeline"]["success"], receipt[form + "_pipeline"]
+                    verdict = receipt[form + "_preview"]
+                    assert verdict["data"]["preview_is_valid"], verdict
+                    assert {"path_allowlist", "plugin_instantiation", "graph_structure", "schema_compatibility"} <= {
+                        check["name"] for check in verdict["runtime_preflight"]["checks"] if check["passed"]
+                    }
+                receipt["patch"] = await call("patch_output_options", {"sink_name": "result", "patch": {"path": "patched.csv"}})
+                assert receipt["patch"]["success"], receipt["patch"]
+                sid = receipt["new"]["data"]["session_id"]
+                await call("save_session", {"session_id": sid})
+                saved_path = directory / "scratch" / f"{sid}.json"
+                saved = saved_path.read_bytes()
+                outside = directory / "outside.csv"
+                outside.write_text("text\nprivate\n")
+                (root / "escape.csv").symlink_to(outside)
+                for value in (str(outside), "../outside.csv", "escape.csv"):
+                    refusal = await call("patch_source_options", {"source_name": "orders", "patch": {"path": value}})
+                    assert not refusal["success"] and refusal["validation"]["errors"][0]["error_code"] == "source_path_policy_invalid", (
+                        refusal
+                    )
+                    await call("save_session", {"session_id": sid})
+                    assert saved_path.read_bytes() == saved
+                receipt["export"] = await call("generate_yaml", {})
+                assert receipt["export"]["success"], receipt["export"]
+                assert "input.csv" not in json.dumps(receipt["export"])
+                assert "patched.csv" not in json.dumps(receipt["export"])
+                await call("save_session", {"session_id": sid})
+                assert saved_path.read_bytes() == saved
+                receipt["private"] = json.loads(saved)
+                legacy = json.loads(saved)
+                legacy["sources"]["orders"]["options"]["path"] = str(outside)
+                legacy["version"] += 1
+                saved_path.write_text(json.dumps(legacy))
+                escaped = saved_path.read_bytes()
+                receipt["legacy_load"] = await call("load_session", {"session_id": sid})
+                receipt["legacy_preview"] = await call("preview_pipeline", {})
+                assert receipt["legacy_load"]["success"], receipt["legacy_load"]
+                verdict = receipt["legacy_preview"]
+                assert not verdict["data"]["preview_is_valid"]
+                assert any(check["name"] == "path_allowlist" and not check["passed"] for check in verdict["runtime_preflight"]["checks"]), (
+                    verdict
+                )
+                await call("save_session", {"session_id": sid})
+                # Loading retains private options; a save canonicalizes JSON.
+                assert json.loads(saved_path.read_bytes()) == json.loads(escaped)
+                provider_source = {
+                    **source,
+                    "on_success": "rows",
+                    "options": {"path": "PRIVATE-SOURCE.csv", "schema": {"mode": "observed"}},
+                }
+                provider_output = {**output, "options": {**output["options"], "path": "PRIVATE-OUTPUT.csv"}}
+                provider_node = {
+                    "id": "retrieval",
+                    "node_type": "transform",
+                    "plugin": "rag_retrieval",
+                    "input": "rows",
+                    "on_success": "result",
+                    "on_error": "discard",
+                    "options": {
+                        "provider": "chroma",
+                        "provider_config": {"collection": "docs", "persist_directory": "PRIVATE-PROVIDER"},
+                        "schema": {"mode": "flexible", "fields": ["text: str"]},
+                        "output_prefix": "rag_",
+                        "query_field": "text",
+                    },
+                }
+                receipt["provider_author"] = await call(
+                    "set_pipeline",
+                    {"sources": {"orders": provider_source}, "nodes": [provider_node], "edges": [], "outputs": [provider_output]},
+                )
+                assert receipt["provider_author"]["success"], receipt["provider_author"]
+                # Authoring/export never invokes the provider or a preview.
+                receipt["provider_export"] = await call("generate_yaml", {})
+                assert receipt["provider_export"]["success"], receipt["provider_export"]
+                for private_path in ("PRIVATE-SOURCE.csv", "PRIVATE-OUTPUT.csv", "PRIVATE-PROVIDER"):
+                    assert private_path not in json.dumps(receipt["provider_export"])
+                await call("save_session", {"session_id": sid})
+                provider_saved = saved_path.read_bytes()
+                provider_private = json.loads(provider_saved)
+                assert provider_private["sources"]["orders"]["options"]["path"] == "PRIVATE-SOURCE.csv"
+                assert provider_private["outputs"][0]["options"]["path"] == "outputs/PRIVATE-OUTPUT.csv"
+                assert provider_private["nodes"][0]["options"]["provider_config"]["persist_directory"] == "PRIVATE-PROVIDER"
+                await call("generate_yaml", {})
+                await call("save_session", {"session_id": sid})
+                assert saved_path.read_bytes() == provider_saved
+                receipt["provider_private"] = provider_private
+    receipt["returncode"] = processes[0].returncode
+    if sys.platform == "linux":
+        assert not Path(f"/proc/{receipt['topology']['supervisor']}").exists()
+        assert not Path(f"/proc/{receipt['topology']['runner']}").exists()
+    (directory / "receipt.json").write_text(json.dumps(receipt, indent=2))
+    assert receipt["source"]["success"] and receipt["output"]["success"], receipt
+    assert "transport_error" not in receipt["preview"], receipt["preview"]
+    assert receipt["preview"]["data"]["preview_is_valid"], receipt["preview"]
+    assert receipt["returncode"] == 0, receipt["returncode"]
+    return receipt
+
+
+if __name__ == "__main__":
+    asyncio.run(probe(Path(sys.argv[1])))
diff --git a/tests/helpers/portable_supervisor_probe.py b/tests/helpers/portable_supervisor_probe.py
new file mode 100644
index 000000000..6c0ce82b7
--- /dev/null
+++ b/tests/helpers/portable_supervisor_probe.py
@@ -0,0 +1,377 @@
+"""Isolated probes using production custody and recovery, never a test owner."""
+
+from __future__ import annotations
+
+import json
+import os
+import signal
+import sys
+import time
+from contextlib import suppress
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def event(directory: Path, name: str) -> None:
+    (directory / name).write_text(str(os.getpid()))
+
+
+def supervise(directory: Path, mode: str, speed: int, ignored_chld: bool) -> int:
+    import runpy
+    import socket
+
+    namespace = runpy.run_path(str(ROOT / "src/elspeth/composer_mcp/portable_supervisor.py"))
+    phase_started = None
+
+    def clock():
+        nonlocal phase_started
+        now = time.monotonic_ns()
+        if owner.armed_at is not None and (not mode.startswith("early-stop") or (directory / "connected").exists()):
+            return owner.armed_at + (now - owner.armed_at) * speed
+        if owner.completed:
+            if phase_started is None:
+                phase_started = now
+            return phase_started + (now - phase_started) * speed
+        return now
+
+    owner = namespace["_Supervisor"](
+        [sys.executable, str(Path(__file__)), "child", str(directory), mode],
+        _clock_ns=clock,
+    )
+    if mode.startswith("early-stop") and mode != "early-stop-signal":
+        owner.stop_requested = True
+    original_socket = socket.socket
+    if mode.startswith("early-stop-fragmented"):
+
+        class FragmentingSocket(original_socket):
+            hold_until = 0.0
+
+            def send(self, data, flags=0):
+                if b"WATCHING_ACK" in data and b"SHUTDOWN_REQUEST" in data:
+                    prefix_length = 4 + int.from_bytes(data[:4], "big") + 2
+                    self.hold_until = time.monotonic() + 0.1
+                    event(directory, "fragmented")
+                    return super().send(data[:prefix_length], flags)
+                if time.monotonic() < self.hold_until:
+                    raise BlockingIOError
+                return super().send(data, flags)
+
+        # Only transport fragmentation is injected. The real selector owner,
+        # sockets, Popen target, deadlines and recovery callbacks all run.
+        socket.socket = FragmentingSocket
+    if ignored_chld:
+        signal.signal(signal.SIGCHLD, signal.SIG_IGN)
+
+    def expired(signum: int, frame: object) -> None:
+        raise TimeoutError("Outer owned-process probe expired")
+
+    signal.signal(signal.SIGALRM, expired)
+    signal.alarm(45 if speed == 1 else 12)
+    try:
+        result = owner.run()
+        assert owner.child is not None
+        (directory / "supervisor.json").write_text(
+            json.dumps(
+                {
+                    "pid": owner.child.pid,
+                    "returncode": owner.child.returncode,
+                    "reaped": owner.child.poll() is not None,
+                    "failed": owner.failed,
+                    "completed": owner.completed,
+                    "result": result,
+                }
+            )
+        )
+        return 128 - result if result < 0 else result
+    finally:
+        signal.alarm(0)
+        socket.socket = original_socket
+
+
+def raw_child(directory: Path, mode: str) -> int:
+    import socket
+
+    from elspeth.contracts.process_watchdog_wire import FrameKind, FrameReader, RecoveryReason, WatchdogFrame, encode_frame
+
+    port = int(os.environ.pop("_ELSPETH_COMPOSER_CONTROL_PORT"))
+    nonce = os.environ.pop("_ELSPETH_COMPOSER_CONTROL_NONCE")
+    if mode == "peer-flood":
+        held = []
+        for _ in range(12):
+            peer = socket.create_connection(("127.0.0.1", port), timeout=1)
+            peer.sendall(b"\x00")
+            held.append(peer)
+        while True:
+            time.sleep(1)
+    if mode == "no-handshake":
+        while True:
+            time.sleep(1)
+    channel = socket.create_connection(("127.0.0.1", port), timeout=1)
+    channel.settimeout(1)
+    reader = FrameReader()
+
+    def send(kind, *, identity_nonce=nonce, pid=None):
+        channel.sendall(
+            encode_frame(
+                WatchdogFrame(
+                    kind,
+                    identity_nonce,
+                    os.getpid() if pid is None else pid,
+                    RecoveryReason.NORMAL_SHUTDOWN if kind is FrameKind.BEGIN_RECOVERY else None,
+                )
+            )
+        )
+
+    def receive():
+        while True:
+            frames = reader.feed(channel.recv(reader.read_capacity))
+            if frames:
+                assert len(frames) == 1
+                return frames[0]
+
+    if mode == "wrong-nonce":
+        send(FrameKind.HELLO, identity_nonce="0" * 64)
+    elif mode == "wrong-pid":
+        send(FrameKind.HELLO, pid=os.getppid())
+    elif mode == "partial-hello":
+        channel.sendall(b"\x00\x00")
+    else:
+        extra = None
+        if mode == "extra-peer":
+            extra = socket.create_connection(("127.0.0.1", port), timeout=1)
+            extra.sendall(b"\x00")
+        send(FrameKind.HELLO)
+        assert receive().kind is FrameKind.WATCHING_ACK
+        event(directory, "authenticated")
+        if extra is not None:
+            with suppress(ConnectionResetError):
+                assert extra.recv(1) == b""
+            extra.close()
+        if mode == "wrong-direction":
+            send(FrameKind.SHUTDOWN_REQUEST)
+        elif mode == "reflected-pid":
+            send(FrameKind.BEGIN_RECOVERY, pid=os.getppid())
+        elif mode == "frame-flood":
+            for _ in range(9):
+                try:
+                    send(FrameKind.BEGIN_RECOVERY)
+                    receive()
+                except (OSError, AssertionError):
+                    break
+        elif mode in ("replay", "partial-flood"):
+            send(FrameKind.BEGIN_RECOVERY)
+            first = receive()
+            assert first.kind is FrameKind.GRACE_ACK
+            event(directory, "armed")
+            if mode == "replay":
+                time.sleep(0.08)
+                send(FrameKind.BEGIN_RECOVERY)
+                assert receive() == first
+                event(directory, "immutable")
+            else:
+                channel.sendall(b"\x00\x00\x03\xff")
+                while True:
+                    try:
+                        channel.sendall(b" ")
+                        time.sleep(0.025)
+                    except OSError:
+                        break
+        elif mode == "channel-loss":
+            channel.close()
+        elif mode in ("extra-peer", "raw-normal"):
+            send(FrameKind.COMPLETE)
+            assert receive().kind is FrameKind.DISARM_ACK
+            channel.close()
+            return 0
+    while True:
+        time.sleep(1)
+
+
+def child(directory: Path, mode: str) -> int:
+    if mode in {
+        "no-handshake",
+        "peer-flood",
+        "wrong-nonce",
+        "wrong-pid",
+        "partial-hello",
+        "extra-peer",
+        "wrong-direction",
+        "reflected-pid",
+        "frame-flood",
+        "replay",
+        "partial-flood",
+        "channel-loss",
+        "raw-normal",
+    }:
+        return raw_child(directory, mode)
+    # This is deliberately the first application-facing import/call. Bootstrap
+    # environment must disappear before runtime imports or worker construction.
+    from elspeth.composer_mcp.portable_bootstrap import connect_supervisor
+
+    if mode == "early-stop-signal":
+        event(directory, "before-hello")
+        release_deadline = time.monotonic() + 1.0
+        while not (directory / "release-hello").exists():
+            assert time.monotonic() < release_deadline
+            time.sleep(0.005)
+    connection = connect_supervisor()
+    event(directory, "connected")
+    assert "_ELSPETH_COMPOSER_CONTROL_NONCE" not in os.environ
+    assert "_ELSPETH_COMPOSER_CONTROL_PORT" not in os.environ
+    import asyncio
+    import atexit
+    import threading
+
+    from elspeth.composer_mcp.portable_control import PortableProcessWatchdog
+    from elspeth.contracts.process_watchdog_wire import (
+        BootstrapCompletionWitness,
+        ProcessCompletionWitness,
+        ProcessWatchdogTarget,
+        RecoveryReason,
+    )
+    from elspeth.web.process_recovery import ProcessRecovery
+    from elspeth.web.process_watchdog import ProcessWatchdogFailure
+
+    draining = threading.Event()
+    control = PortableProcessWatchdog(connection, draining)
+    if mode in ("bootstrap", "no-root", "early-stop-bootstrap", "early-stop-fragmented-bootstrap"):
+        if mode == "no-root":
+            try:
+                control.assert_watching()
+            except ProcessWatchdogFailure:
+                event(directory, "unbound-refused")
+            else:
+                raise AssertionError("unbound root admitted workers")
+        control.complete_bootstrap(BootstrapCompletionWitness(control.target))
+        if mode in ("early-stop-bootstrap", "early-stop-fragmented-bootstrap"):
+            assert draining.is_set()
+        event(directory, "bootstrap-completed")
+        return 0
+    if mode in ("early-stop-abort", "early-stop-fragmented-abort"):
+        control.abort_bootstrap(RecoveryReason.FAILED_STARTUP)
+        event(directory, "bootstrap-armed")
+        while True:
+            time.sleep(1)
+
+    async def run():
+        root = asyncio.current_task()
+        assert root is not None
+        control.bind_root_task(root)
+        recovery = ProcessRecovery(watchdog=control, instance_draining=draining)
+        recovery.start_monitor()
+        event(directory, "ready")
+        if mode == "wrong-witness":
+            for witness in (
+                BootstrapCompletionWitness(control.target),
+                ProcessCompletionWitness(ProcessWatchdogTarget(control.target.pid, "0" * 64)),
+                ProcessCompletionWitness(ProcessWatchdogTarget(control.target.pid + 1, control.target.nonce)),
+            ):
+                try:
+                    await control.complete(witness)
+                except ProcessWatchdogFailure:
+                    pass
+                else:
+                    raise AssertionError("invalid completion witness accepted")
+            try:
+                control.complete_bootstrap(BootstrapCompletionWitness(control.target))
+            except ProcessWatchdogFailure:
+                pass
+            else:
+                raise AssertionError("bootstrap completed after root binding")
+            event(directory, "witnesses-refused")
+        if mode == "required-worker":
+            from elspeth.web import async_workers
+
+            async_workers.configure_required_executor_recovery(
+                drain_seconds=0.1,
+                instance_draining=draining,
+                generation_unavailable=threading.Event(),
+                recovery_callback=recovery.required_generation_expired,
+            )
+            entered = threading.Event()
+
+            def blocked():
+                entered.set()
+                threading.Event().wait()
+
+            worker = asyncio.create_task(async_workers.run_sync_in_worker(blocked))
+            while not entered.is_set():
+                await asyncio.sleep(0.005)
+            assert async_workers._GENERATION_CUSTODIAN is not None
+            async_workers._GENERATION_CUSTODIAN.quarantine()
+            try:
+                await asyncio.Event().wait()
+            except asyncio.CancelledError:
+                await recovery.join_escalation()
+                assert recovery._observations
+                event(directory, "required-observed")
+                # The real executor join remains blocked. Withhold COMPLETE.
+                await async_workers.shutdown_async_workers()
+                await worker
+                raise AssertionError("blocked worker unexpectedly settled") from None
+        if mode in ("recovery-block-loop", "production-grace"):
+            recovery.request_shutdown()
+            with suppress(asyncio.CancelledError):
+                await recovery.join_escalation()
+            event(directory, "armed")
+            while True:
+                time.sleep(1)
+        if mode in (
+            "wait-stop",
+            "unresponsive-stop",
+            "supervisor-loss",
+            "early-stop-responsive",
+            "early-stop-unresolved",
+            "early-stop-fragmented",
+            "early-stop-signal",
+        ):
+            if mode in ("unresponsive-stop", "early-stop-unresolved"):
+                while True:
+                    time.sleep(1)
+            try:
+                await asyncio.Event().wait()
+            except asyncio.CancelledError:
+                assert draining.is_set()
+                cancellations = root.cancelling()
+                control.request_graceful_termination()
+                control.request_graceful_termination()
+                assert root.cancelling() == cancellations
+                event(directory, "stopped")
+        if mode == "repeated-cancel":
+            begin = asyncio.create_task(control.begin_recovery(RecoveryReason.NORMAL_SHUTDOWN))
+            await asyncio.sleep(0)
+            begin.cancel()
+            begin.cancel()
+            with suppress(asyncio.CancelledError):
+                await begin
+            first = await control.begin_recovery(RecoveryReason.REQUIRED_WORKER_LOST)
+            assert await control.begin_recovery(RecoveryReason.NORMAL_SHUTDOWN) is first
+            event(directory, "retained")
+        recovery.begin_shutdown()
+        await recovery.join_escalation()
+        if mode == "cancel-completion":
+            completion = asyncio.create_task(control.complete(ProcessCompletionWitness(control.target)))
+            await asyncio.sleep(0)
+            completion.cancel()
+            completion.cancel()
+            with suppress(asyncio.CancelledError):
+                await completion
+        await control.complete(ProcessCompletionWitness(control.target))
+        await recovery.join_monitor_after_completion()
+        event(directory, "completed")
+
+    asyncio.run(run())
+    if mode == "atexit-hang":
+        atexit.register(lambda: threading.Event().wait())
+    if mode == "stdio":
+        sys.stdout.write("MCP-PROBE\n")
+    return 7 if mode == "exit-seven" else 0
+
+
+if __name__ == "__main__":
+    role, directory_text, mode, *options = sys.argv[1:]
+    directory = Path(directory_text)
+    if role == "supervisor":
+        raise SystemExit(supervise(directory, mode, int(options[0]), len(options) > 1))
+    raise SystemExit(child(directory, mode))
