+            super().__init__(draining)
+            self.operations = []
+
+        async def begin_recovery(self, reason):
+            if failure == "ack":
+                raise original
+            result = await super().begin_recovery(reason)
+            self.operations.append("ack")
+            return result
+
+        def request_graceful_termination(self):
+            self.operations.append("graceful")
