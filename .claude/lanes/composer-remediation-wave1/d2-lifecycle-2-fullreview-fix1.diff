@@ -0,0 +1,183 @@
+"""Authenticated child endpoint implementing the real recovery owner contract."""
+
+from __future__ import annotations
+
+import asyncio
+import os
+import threading
+
+from elspeth.composer_mcp.portable_bootstrap import AuthenticatedSupervisor, exchange_sync
+from elspeth.contracts.process_watchdog_wire import (
+    BootstrapCompletionWitness,
+    FrameKind,
+    GraceAcknowledgement,
+    ProcessCompletionWitness,
+    ProcessWatchdogTarget,
+    RecoveryReason,
+    WatchdogFrame,
+    WatchdogProtocolError,
+    encode_frame,
+)
+from elspeth.web.process_watchdog import ProcessWatchdogControl, ProcessWatchdogFailure
+
+
+class PortableProcessWatchdog(ProcessWatchdogControl):
+    """One root task, one socket reader and one retained exchange per phase.
+
+    Construct only with connect_supervisor's authenticated channel. Bind the
+    actual serving root before worker admission; bootstrap completion is then
+    permanently unavailable. A witness is a nominal lifecycle assertion, not
+    an introspection substitute for the caller's required joins.
+    """
+
+    def __init__(self, connection: AuthenticatedSupervisor, instance_draining: threading.Event) -> None:
+        if type(connection) is not AuthenticatedSupervisor:
+            raise ProcessWatchdogFailure("Composer endpoint requires authenticated bootstrap")
+        self._stream = connection.claim()
+        channel, target = self._stream.channel, self._stream.target
+        if type(target) is not ProcessWatchdogTarget or target.pid != os.getpid():
+            channel.close()
+            raise ProcessWatchdogFailure("Composer endpoint target mismatch")
+        self._channel = channel
+        self._target = target
+        self._draining = instance_draining
+        self._root: asyncio.Task[None] | None = None
+        self._reader: asyncio.Task[None] | None = None
+        self._pending: asyncio.Future[WatchdogFrame] | None = None
+        self._expected: FrameKind | None = None
+        self._exchange_lock = asyncio.Lock()
+        self._recovery: asyncio.Task[GraceAcknowledgement] | None = None
+        self._completion: asyncio.Task[None] | None = None
+        self._disarmed = False
+        self._graceful_requested = False
+
+    @property
+    def target(self) -> ProcessWatchdogTarget:
+        return self._target
+
+    def bind_root_task(self, root: asyncio.Task[None]) -> None:
+        if self._root is not None or self._disarmed or root.done() or root.get_loop() is not asyncio.get_running_loop():
+            raise ProcessWatchdogFailure("Composer serving root already bound or unavailable")
+        self._root = root
+        self._reader = asyncio.create_task(self._read_frames(), name="composer-control-reader")
+
+    def assert_watching(self) -> None:
+        if self._disarmed or self._root is None or self._reader is None or self._reader.done():
+            raise ProcessWatchdogFailure("Required Composer supervision is not active")
+
+    async def _read_frames(self) -> None:
+        loop = asyncio.get_running_loop()
+        try:
+            while True:
+                if self._stream.shutdown_requested:
+                    self.request_graceful_termination()
+                for frame in self._stream.take_replies():
+                    if self._pending is not None and not self._pending.done() and frame.kind is self._expected:
+                        self._pending.set_result(frame)
+                        if frame.kind is FrameKind.DISARM_ACK:
+                            self._disarmed = True
+                            return
+                    else:
+                        raise WatchdogProtocolError("Unexpected Composer control reply")
+                data = await loop.sock_recv(self._channel, self._stream.read_capacity)
+                if not data:
+                    raise ProcessWatchdogFailure("Private Composer supervisor channel closed")
+                self._stream.feed(data)
+        except (OSError, WatchdogProtocolError, ProcessWatchdogFailure) as error:
+            failure = ProcessWatchdogFailure("Private Composer supervisor channel failed")
+            if self._pending is not None and not self._pending.done():
+                self._pending.set_exception(failure)
+            raise failure from error
+        finally:
+            self._channel.close()
+
+    async def _request(self, frame: WatchdogFrame, expected: FrameKind) -> WatchdogFrame:
+        async with self._exchange_lock:
+            self.assert_watching()
+            self._pending = asyncio.get_running_loop().create_future()
+            self._expected = expected
+            try:
+                async with asyncio.timeout(1.0):
+                    await asyncio.get_running_loop().sock_sendall(self._channel, encode_frame(frame))
+                    return await self._pending
+            except (OSError, TimeoutError) as error:
+                self._channel.close()
+                raise ProcessWatchdogFailure("Private Composer exchange failed") from error
+            finally:
+                self._pending = None
+                self._expected = None
+
+    async def _begin_recovery(self, reason: RecoveryReason) -> GraceAcknowledgement:
+        frame = await self._request(
+            WatchdogFrame(FrameKind.BEGIN_RECOVERY, self.target.nonce, self.target.pid, reason), FrameKind.GRACE_ACK
+        )
+        assert frame.armed_at_ns is not None and frame.deadline_ns is not None
+        return GraceAcknowledgement(self.target, frame.armed_at_ns, frame.deadline_ns)
+
+    async def begin_recovery(self, reason: RecoveryReason) -> GraceAcknowledgement:
+        self._draining.set()
+        if self._recovery is None:
+            self.assert_watching()
+            self._recovery = asyncio.create_task(self._begin_recovery(reason), name="composer-recovery-exchange")
+        # Cancellation never transfers reader ownership or discards a late ACK.
+        return await asyncio.shield(self._recovery)
+
+    async def _complete(self) -> None:
+        if self._recovery is not None:
+            await asyncio.shield(self._recovery)
+        await self._request(WatchdogFrame(FrameKind.COMPLETE, self.target.nonce, self.target.pid), FrameKind.DISARM_ACK)
+        assert self._reader is not None
+        await asyncio.shield(self._reader)
+
+    async def complete(self, witness: ProcessCompletionWitness) -> None:
+        if type(witness) is not ProcessCompletionWitness or witness.target != self.target:
+            raise ProcessWatchdogFailure("Composer completion witness mismatch")
+        if self._completion is None:
+            self.assert_watching()
+            self._completion = asyncio.create_task(self._complete(), name="composer-completion-exchange")
+        await asyncio.shield(self._completion)
+
+    def complete_bootstrap(self, witness: BootstrapCompletionWitness) -> None:
+        if type(witness) is not BootstrapCompletionWitness or witness.target != self.target or self._root is not None or self._disarmed:
+            raise ProcessWatchdogFailure("Composer bootstrap completion witness or phase mismatch")
+        try:
+            reply = exchange_sync(self._stream, WatchdogFrame(FrameKind.COMPLETE, self.target.nonce, self.target.pid))
+            if reply.kind is not FrameKind.DISARM_ACK:
+                raise ProcessWatchdogFailure("Composer bootstrap completion refused")
+            if self._stream.shutdown_requested:
+                self._draining.set()
+            self._disarmed = True
+        finally:
+            self._channel.close()
+
+    def abort_bootstrap(self, reason: RecoveryReason, witness: BootstrapCompletionWitness | None = None) -> None:
+        if reason is not RecoveryReason.FAILED_STARTUP or self._root is not None:
+            raise ProcessWatchdogFailure("Composer bootstrap abort phase mismatch")
+        if witness is not None:
+            self.complete_bootstrap(witness)
+            return
+        self._draining.set()
+        try:
+            reply = exchange_sync(self._stream, WatchdogFrame(FrameKind.BEGIN_RECOVERY, self.target.nonce, self.target.pid, reason))
+            if reply.kind is not FrameKind.GRACE_ACK:
+                raise ProcessWatchdogFailure("Composer bootstrap recovery refused")
+        except BaseException:
+            self.force_termination()
+            raise
+
+    async def observe_helper_outcome(self) -> None:
+        self.assert_watching()
+        assert self._reader is not None
+        await asyncio.shield(self._reader)
+
+    def request_graceful_termination(self) -> None:
+        if self._root is None:
+            raise ProcessWatchdogFailure("Composer serving root is not bound")
+        self._draining.set()
+        if not self._graceful_requested:
+            self._graceful_requested = True
+            self._root.cancel("Composer process shutdown")
+
+    def force_termination(self) -> None:
+        # Self-only authority; independent parent still enforces a stuck loop.
+        os._exit(70)
diff --git a/src/elspeth/composer_mcp/portable_supervisor.py b/src/elspeth/composer_mcp/portable_supervisor.py
new file mode 100644
index 000000000..b0f4a0c47
--- /dev/null
+++ b/src/elspeth/composer_mcp/portable_supervisor.py
@@ -0,0 +1,278 @@
+"""Private, dedicated Popen lifetime owner. Requires IPv4 loopback binding.
+
+Execute this file directly to keep the supervisor stdlib-only. It must not be
+embedded in a host with competing child reapers. Stdio belongs directly to the
+runner; this owner never reads stdin or writes stdout. There is no public entry
+point until the Composer lifespan is integrated.
+"""
+
+from __future__ import annotations
+
+import os
+import secrets
+import selectors
+import signal
+import socket
+import subprocess
+import sys
+import time
+from collections.abc import Callable, Sequence
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING or __package__:
+    from elspeth.contracts.process_watchdog_wire import GRACE_NS, FrameKind, FrameReader, WatchdogFrame, WatchdogProtocolError, encode_frame
+else:
+    # The contract file itself has only stdlib dependencies. Importing the
+    # contracts package would execute its eager application re-exports.
+    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "contracts"))
+    from process_watchdog_wire import GRACE_NS, FrameKind, FrameReader, WatchdogFrame, WatchdogProtocolError, encode_frame
+
+STARTUP_NS = 2_000_000_000
+EXIT_NS = 2_000_000_000
+POLL_SECONDS = 0.02
+PEER_LIMIT = 8
+PORT_ENV = "_ELSPETH_COMPOSER_CONTROL_PORT"
+NONCE_ENV = "_ELSPETH_COMPOSER_CONTROL_NONCE"
+_CREATE_NEW_PROCESS_GROUP = 0x00000200  # Win32 CREATE_NEW_PROCESS_GROUP
+
+
+def _launch_child(command: Sequence[str], environment: dict[str, str], *, windows: bool) -> subprocess.Popen[bytes]:
+    return subprocess.Popen(
+        command,
+        env=environment,
+        close_fds=True,
+        creationflags=_CREATE_NEW_PROCESS_GROUP if windows else 0,
+        start_new_session=not windows,
+    )
+
+
+class SupervisorFailure(RuntimeError):
+    """The owned child could not be terminated/reaped truthfully."""
+
+
+class _Supervisor:
+    """Single-threaded owner. The clock seam is private subprocess-test support."""
+
+    def __init__(self, command: Sequence[str], *, _clock_ns: Callable[[], int] = time.monotonic_ns) -> None:
+        self.command = command
+        self.clock = _clock_ns
+        self.child: subprocess.Popen[bytes] | None = None
+        self.stop_requested = False
+        self.armed_at: int | None = None
+        self.deadline: int | None = None
+        self.failed = False
+        self.completed = False
+
+    def _stop(self, signum: int, frame: object) -> None:
+        # No socket, signal or wait operations in a signal handler.
+        self.stop_requested = True
+
+    def _arm(self) -> None:
+        if self.armed_at is None:
+            self.armed_at = self.clock()
+            recovery_deadline = self.armed_at + GRACE_NS
+            self.deadline = min(self.deadline, recovery_deadline) if self.deadline is not None else recovery_deadline
+
+    def _kill_and_reap(self) -> int:
+        assert self.child is not None
+        # This loop is the exclusive poll/signal/reap authority. Never signal
+        # after observed exit; on Windows Popen.kill uses the retained handle.
+        status = self.child.poll()
+        if status is not None:
+            return status
+        try:
+            self.child.kill()
+            return self.child.wait(timeout=1.0)
+        except (OSError, subprocess.TimeoutExpired) as error:
+            raise SupervisorFailure("Owned Composer child termination/reap failed") from error
+
+    def run(self) -> int:
+        previous = {sig: signal.getsignal(sig) for sig in (signal.SIGINT, signal.SIGTERM)}
+        previous_chld = None
+        if os.name != "nt":
+            previous_chld = signal.getsignal(signal.SIGCHLD)
+            # Inherited SIG_IGN can discard wait status and lose PID custody.
+            signal.signal(signal.SIGCHLD, signal.SIG_DFL)
+        for sig in previous:
+            signal.signal(sig, self._stop)
+        try:
+            return self._run_owned()
+        finally:
+            for sig, handler in previous.items():
+                signal.signal(sig, handler)
+            if os.name != "nt":
+                signal.signal(signal.SIGCHLD, previous_chld)
+
+    def _run_owned(self) -> int:
+        nonce = secrets.token_hex(32)
+        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as listener, selectors.DefaultSelector() as selector:
+            listener.bind(("127.0.0.1", 0))
+            listener.listen(PEER_LIMIT)
+            listener.setblocking(False)
+            selector.register(listener, selectors.EVENT_READ)
+            environment = os.environ.copy()
+            environment[PORT_ENV] = str(listener.getsockname()[1])
+            environment[NONCE_ENV] = nonce
+            # No received identity ever influences this process reference.
+            self.child = _launch_child(self.command, environment, windows=os.name == "nt")
+            environment.pop(NONCE_ENV)
+            peers: dict[socket.socket, FrameReader] = {}
+            control: socket.socket | None = None
+            outgoing = bytearray()
+            attempts = 0
+            startup_deadline = self.clock() + STARTUP_NS
+            shutdown_sent = False
+            listener_open = True
+
+            def close_peer(peer: socket.socket) -> None:
+                selector.unregister(peer)
+                peer.close()
+                del peers[peer]
+
+            def fail_channel() -> None:
+                nonlocal control
+                self.failed = True
+                self._arm()
+                if control is not None:
+                    close_peer(control)
+                    control = None
+                outgoing.clear()
+
+            def queue(frame: WatchdogFrame) -> None:
+                assert control is not None
+                outgoing.extend(encode_frame(frame))
+                if len(outgoing) > 1028:
+                    raise WatchdogProtocolError("Supervisor outgoing buffer exceeded")
+                selector.modify(control, selectors.EVENT_READ | selectors.EVENT_WRITE)
+
+            try:
+                while True:
+                    status = self.child.poll()
+                    if status is not None:
+                        return status if status != 0 else 0 if self.completed and not self.failed else 2
+                    now = self.clock()
+                    if control is None and not self.completed and listener_open and now >= startup_deadline:
+                        self.failed = True
+                        return self._kill_and_reap() or 2
+                    if self.deadline is not None and now >= self.deadline:
+                        self.failed = True
+                        return self._kill_and_reap() or 2
+                    if self.stop_requested:
+                        self._arm()
+                        if control is not None and not shutdown_sent and not self.completed:
+                            try:
+                                queue(WatchdogFrame(FrameKind.SHUTDOWN_REQUEST, nonce, self.child.pid))
+                                shutdown_sent = True
+                            except (OSError, WatchdogProtocolError):
+                                fail_channel()
+                    nearest = self.deadline
+                    if listener_open:
+                        nearest = min(nearest, startup_deadline) if nearest is not None else startup_deadline
+                    timeout = POLL_SECONDS if nearest is None else min(POLL_SECONDS, max(0.0, (nearest - now) / 1e9))
+                    for key, events in selector.select(timeout):
+                        if key.fileobj is listener:
+                            try:
+                                accepted, _ = listener.accept()
+                            except BlockingIOError:
+                                continue
+                            attempts += 1
+                            if attempts > PEER_LIMIT:
+                                accepted.close()
+                                continue
+                            accepted.setblocking(False)
+                            peers[accepted] = FrameReader()
+                            selector.register(accepted, selectors.EVENT_READ)
+                            continue
+                        peer = key.fileobj
+                        assert isinstance(peer, socket.socket)
+                        if peer not in peers:
+                            continue
+                        try:
+                            if events & selectors.EVENT_WRITE and outgoing and peer is control:
+                                try:
+                                    sent = peer.send(outgoing)
+                                except BlockingIOError:
+                                    sent = 0
+                                del outgoing[:sent]
+                                if not outgoing:
+                                    selector.modify(peer, selectors.EVENT_READ)
+                            if events & selectors.EVENT_READ:
+                                try:
+                                    raw = peer.recv(peers[peer].read_capacity)
+                                except BlockingIOError:
+                                    continue
+                                if not raw:
+                                    if peer is control and self.completed:
+                                        close_peer(peer)
+                                        control = None
+                                        continue
+                                    raise WatchdogProtocolError("Supervisor channel closed")
+                                for frame in peers[peer].feed(raw):
+                                    frame.validate_target(nonce=nonce, target_pid=self.child.pid)
+                                    if control is None and listener_open:
+                                        if frame.kind is not FrameKind.HELLO:
+                                            raise WatchdogProtocolError("Supervisor requires HELLO")
+                                        control = peer
+                                        selector.unregister(listener)
+                                        listener.close()
+                                        listener_open = False
+                                        for other in tuple(peers):
+                                            if other is not peer:
+                                                close_peer(other)
+                                        queue(WatchdogFrame(FrameKind.WATCHING_ACK, nonce, self.child.pid))
+                                    elif peer is not control or self.completed:
+                                        raise WatchdogProtocolError("Unexpected supervisor frame")
+                                    elif frame.kind is FrameKind.BEGIN_RECOVERY:
+                                        self._arm()
+                                        queue(
+                                            WatchdogFrame(
+                                                FrameKind.GRACE_ACK,
+                                                nonce,
+                                                self.child.pid,
+                                                armed_at_ns=self.armed_at,
+                                                deadline_ns=self.deadline,
+                                            )
+                                        )
+                                    elif frame.kind is FrameKind.COMPLETE:
+                                        self.completed = True
+                                        exit_deadline = self.clock() + EXIT_NS
+                                        self.deadline = min(self.deadline, exit_deadline) if self.deadline is not None else exit_deadline
+                                        queue(WatchdogFrame(FrameKind.DISARM_ACK, nonce, self.child.pid))
+                                    else:
+                                        raise WatchdogProtocolError("Wrong supervisor frame direction")
+                        except (OSError, WatchdogProtocolError):
+                            if peer is control:
+                                fail_channel()
+                            elif peer in peers:
+                                close_peer(peer)
+            except BaseException:
+                self._kill_and_reap()
+                raise
+            finally:
+                for peer in tuple(peers):
+                    close_peer(peer)
+
+
+def main() -> int:
+    if len(sys.argv) < 2:
+        sys.stderr.write("Private Composer supervisor requires an owned runner command\n")
+        return 2
+    try:
+        return _Supervisor(sys.argv[1:]).run()
+    except (OSError, SupervisorFailure):
+        sys.stderr.write("Private Composer supervisor startup or process custody failed\n")
+        return 2
+
+
+if __name__ == "__main__":
+    result = main()
+    if result < 0 and os.name != "nt":
+        # Custody ended in main: the child has already been reaped. Reflect its
+        # actual signal status to stdio clients observing this launcher Popen.
+        terminated_by = -result
+        if terminated_by != signal.SIGKILL:
+            signal.signal(terminated_by, signal.SIG_DFL)
+        signal.pthread_sigmask(signal.SIG_UNBLOCK, {terminated_by})
+        os.kill(os.getpid(), terminated_by)
+    raise SystemExit(128 - result if result < 0 else result)
