                _capture_freeform_child(
                    service.add_message_with_transcript(
                        session.id,
                        "user",
                        request.content,
                        operation_id=UUID(turn.operation_id),
                        requested_state_id=request.state_id,
                        composition_state_id=compose_base_state_id,
