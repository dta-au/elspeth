        for fault in (["live_mismatch", "missing_row", "foreign_path", "wrong_invocation", "corrupt_bytes"] if producer == "replacement" else ["live_mismatch", "foreign_path", "wrong_invocation", "corrupt_bytes"] if producer == "deletion" else ["live_mismatch", "foreign_path"])
