{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__filigree__.*",
        "hooks": [
          {
            "type": "command",
            "command": "filigree ensure-dashboard",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "filigree session-context",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "filigree ensure-dashboard",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "loomweave hook session-start --path \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.venv/bin/ruff\" check --fix $CLAUDE_FILE_PATHS 2>&1 | tail -20"
          }
        ]
      }
    ]
  }
}
