# .dockerignore - Exclude files from Docker build context
#
# This speeds up builds and reduces image size by excluding
# development files, tests, documentation, and git metadata.
#
# SEMANTICS: this is NOT gitignore. Docker matches each pattern with Go's
# filepath.Match against the context-relative path, anchored at the root:
# `*.db` excludes only a top-level foo.db and `worktrees/` only ./worktrees.
# A pattern matches at any depth ONLY when written `**/`-prefixed. Pinned by
# tests/unit/deployment/test_deploy_ignore_policy.py.

# Git
.git/
.gitignore
.gitattributes

# Python development
**/__pycache__/
**/*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
dist/
build/
eggs/
.eggs/
*.manifest
*.spec

# Virtual environments (host venvs, not container)
.venv/
venv/
ENV/
env/

# JavaScript dependency trees are generated from package-lock.json inside Docker.
**/node_modules/

# Frontend unit-test sources are not part of the production SPA bundle. Keeping
# them out of the Docker context also isolates the image build from unrelated
# test-only type fixtures while application source remains fully typechecked.
src/elspeth/web/frontend/src/**/*.test.ts
src/elspeth/web/frontend/src/**/*.test.tsx

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Testing
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.hypothesis/

# Type checking
.mypy_cache/
.dmypy.json

# Documentation (not needed in runtime image)
docs/
*.md
!README.md

# Development files
tests/
conftest.py
pytest.ini
setup.cfg
.pre-commit-config.yaml
Makefile

# CI/CD (not needed in image)
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile
azure-pipelines.yml

# Docker files (avoid recursive inclusion)
Dockerfile*
docker-compose*.yaml
docker-compose*.yml
.docker/

# Worktrees — agent worktrees live under .claude/worktrees/<name> (AGENTS.md)
# and may nest; the panel convention is .worktrees/. Each is a full checkout,
# so a top-level-only pattern lets gigabytes of sibling branches (and their
# untracked .env / *.pem / *.db) into the build context.
**/.claude/
**/.worktrees/
worktrees/

# Data and state (mounted at runtime)
**/*.db
**/*.sqlite
**/*.sqlite3
payloads/
landscape.db

# Terraform working data and operator-specific deployment inputs
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example

# Secrets (never include in image!) — any depth, so a stray credential inside
# src/ or a worktree cannot ride in on `COPY src/ ./src/`.
**/.env
**/.env.*
**/*.pem
!deploy/aws-ecs/trust/global-bundle.pem
**/*.key
# Top-level only on purpose: src/elspeth/web/secrets/ is a real package.
secrets/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Alembic (migrations run separately)
alembic/

# Example and test configurations
examples/
fixtures/
