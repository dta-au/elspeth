      "cols": 7,
      "match": {
        "col_1": "id",
        "col_2": "entry",
        "col_5": "posture"
      },
      "widths": [
        0.05,
        0.34,
        0.07,
        0.14,
        0.07,
        0.1,
        0.23
      ]
    },
    {
