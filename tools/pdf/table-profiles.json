      "match": {
        "col_1": "decision",
        "col_2": "options",
        "col_3": "decide by"
      },
      "widths": [
        0.19,
        0.26,
        0.15,
        0.1,
        0.3
      ]
    },
    {
      "_doc": "control-pack: RAID carried deliberately",
      "cols": 3,
      "match": {
        "col_1": "item",
        "col_2": "why",
