# Copy this file to /etc/elspeth/elspeth-web.env and restrict it to root and
# the elspeth service account before starting elspeth-web.service.

# The portable native-Linux default is a single web process with local SQLite
# state and persistent payloads under systemd's private StateDirectory.
ELSPETH_WEB__DEPLOYMENT_TARGET=linux-systemd
ELSPETH_WEB__DEPLOYMENT_STATE_MODE=sqlite-single
ELSPETH_WEB__DATA_DIR=/var/lib/elspeth/data
ELSPETH_WEB__PAYLOAD_STORE_PATH=/var/lib/elspeth/payloads

# Switching to external-postgresql requires two configuration changes:
# 1. Change DEPLOYMENT_STATE_MODE above from sqlite-single to external-postgresql.
# 2. Uncomment and set both distinct database URL lines below.
# ELSPETH_WEB__SESSION_DB_URL=postgresql+psycopg://elspeth@postgresql.example.invalid:5432/elspeth_sessions
# ELSPETH_WEB__LANDSCAPE_URL=postgresql+psycopg://elspeth@postgresql.example.invalid:5432/elspeth_landscape

# Production composer limits shared by the supported deployment profiles.
ELSPETH_WEB__COMPOSER_MAX_COMPOSITION_TURNS=15
ELSPETH_WEB__COMPOSER_MAX_DISCOVERY_TURNS=10
ELSPETH_WEB__COMPOSER_TIMEOUT_SECONDS=85
ELSPETH_WEB__COMPOSER_RATE_LIMIT_PER_MINUTE=10

# Required application secrets. Generate and install real values locally;
# this tracked example deliberately contains no usable secret material.
ELSPETH_WEB__SECRET_KEY=
ELSPETH_WEB__SHAREABLE_LINK_SIGNING_KEY=

# Optional provider and fingerprint keys. Leave unused variables empty.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_API_KEY=
AZURE_CONTENT_SAFETY_KEY=
AZURE_OPENAI_API_KEY=
ELSPETH_FINGERPRINT_KEY=
