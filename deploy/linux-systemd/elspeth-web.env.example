# Copy this file to /etc/elspeth/elspeth-web.env and restrict it to root and
# the elspeth service account before starting elspeth-web.service.

# The portable native-Linux default is a single web process with local SQLite
# state and persistent payloads under systemd's private StateDirectory.
ELSPETH_WEB__DEPLOYMENT_TARGET=linux-systemd
ELSPETH_WEB__DEPLOYMENT_STATE_MODE=sqlite-single
ELSPETH_WEB__DATA_DIR=/var/lib/elspeth/data
ELSPETH_WEB__PAYLOAD_STORE_PATH=/var/lib/elspeth/payloads

# Switching to external-postgresql requires two configuration changes:
# 1. Change DEPLOYMENT_STATE_MODE above from sqlite-single to external-postgresql.
# 2. Uncomment and set both distinct database URL lines below.
# ELSPETH_WEB__SESSION_DB_URL=postgresql+psycopg://elspeth@postgresql.example.invalid:5432/elspeth_sessions
# ELSPETH_WEB__LANDSCAPE_URL=postgresql+psycopg://elspeth@postgresql.example.invalid:5432/elspeth_landscape

# Production composer limits shared by the supported deployment profiles.
ELSPETH_WEB__COMPOSER_MAX_COMPOSITION_TURNS=15
ELSPETH_WEB__COMPOSER_MAX_DISCOVERY_TURNS=10
ELSPETH_WEB__COMPOSER_TIMEOUT_SECONDS=85
ELSPETH_WEB__COMPOSER_RATE_LIMIT_PER_MINUTE=10

# Web LLM configuration. Leaving this block commented out boots the service
# with the development defaults: composer model gpt-5.5 (requires
# OPENAI_API_KEY) and advisor model anthropic/claude-sonnet-4-6 (requires
# ANTHROPIC_API_KEY) — with neither key set the Composer is unavailable —
# and with zero LLM profiles, so the web surface offers no llm nodes and no
# user gets the first-run tutorial. Full contract:
# docs/reference/environment-variables.md, "Web LLM Configuration".

# Composer and advisor models are provider-prefixed LiteLLM ids; the prefix
# selects the provider API key the process must hold. The advisor must be a
# different model than the composer (the provider prefix is ignored when
# comparing). These examples need only OPENROUTER_API_KEY below.
# ELSPETH_WEB__COMPOSER_MODEL=openrouter/openai/gpt-5.5
# ELSPETH_WEB__COMPOSER_ADVISOR_MODEL=openrouter/anthropic/claude-sonnet-4.6

# LLM profiles map an opaque alias to an operator-owned provider binding; web
# authors select only the alias. A server-scoped OpenRouter or Azure profile
# must name its credential_scope and credential_ref; the ref is resolved
# through the server secret store and must appear in the server secret
# allowlist (OPENROUTER_API_KEY is allowlisted by default). Server-scoped
# credential use is fingerprinted into the audit trail, so also set
# ELSPETH_FINGERPRINT_KEY below.
# ELSPETH_WEB__LLM_PROFILES='{"standard":{"provider":"openrouter","model":"anthropic/claude-sonnet-4.6","credential_scope":"server","credential_ref":"OPENROUTER_API_KEY"}}'

# The first-run tutorial needs A profile, not its OWN profile — point this at an
# ordinary general-purpose alias defined above. It must name one that exists: if
# you rename or remove that profile without changing this line too, the service
# refuses to start. This alias is also listed first for authors and is the one the
# Composer's worked examples use, so keep it on a general-purpose tier.
# ELSPETH_WEB__TUTORIAL_LLM_PROFILE=standard

# Optional web plugins beyond the always-authorized required web core
# (csv/json/text sources and sinks, field_mapper, llm, web_scrape) must be
# listed here by kind-qualified id; installed plugins absent from the list stay CLI-only and
# are hidden from every web surface. Amazon Textract is listed here too — it
# needs no environment variable of its own, only this authorization plus
# textract:StartDocumentAnalysis / textract:GetDocumentAnalysis on the identity
# the service runs as.
# ELSPETH_WEB__PLUGIN_ALLOWLIST='["transform:aws_bedrock_prompt_shield","transform:aws_bedrock_content_safety","transform:aws_textract_document_analysis"]'

# Authorizing the two shield plugins above is not enough to make them usable:
# a control needs an implementation preference, an enforcement mode, and — for
# the Bedrock controls — an operator-owned Guardrail binding. Set all four
# together or the capability stays unavailable to every author.
#
# Preferences pick the implementation per capability (ordered, each listed once).
# ELSPETH_WEB__PLUGIN_PREFERENCES='{"prompt_shield":["transform:aws_bedrock_prompt_shield"],"content_safety":["transform:aws_bedrock_content_safety"]}'
#
# Control modes decide enforcement. Under "required" every web-authored LLM node
# must be covered — shield dominating its input, content safety dominating every
# one of its output streams — and the planner wires the controls instead of
# recommending them. Under "recommend" the control is advisory.
# ELSPETH_WEB__PLUGIN_CONTROL_MODES='{"prompt_shield":"required","content_safety":"required"}'
#
# Guardrail profiles are the operator-owned half: web authors select only the
# opaque alias, never the identifier, version, or region. The version must be a
# published numeric Guardrail version, not DRAFT. Credentials resolve through the
# ordinary AWS SDK chain (instance role, AWS_PROFILE, or ambient AWS_* variables);
# never put access keys here or in pipeline options.
# ELSPETH_WEB__BEDROCK_GUARDRAIL_PROFILES='[{"alias":"prompt-default","plugin":"aws_bedrock_prompt_shield","guardrail_identifier":"operatorpromptguardrail","guardrail_version":"7","region":"ap-southeast-2"},{"alias":"content-default","plugin":"aws_bedrock_content_safety","guardrail_identifier":"operatorcontentguardrail","guardrail_version":"4","region":"ap-southeast-2"}]'
#
# When a control plugin has more than one profile, name the one it uses by default.
# ELSPETH_WEB__BEDROCK_GUARDRAIL_DEFAULT_PROFILES='{"aws_bedrock_prompt_shield":"prompt-default","aws_bedrock_content_safety":"content-default"}'

# Required application secrets. Generate and install real values locally;
# this tracked example deliberately contains no usable secret material.
ELSPETH_WEB__SECRET_KEY=
ELSPETH_WEB__SHAREABLE_LINK_SIGNING_KEY=

# Optional provider and fingerprint keys. Leave unused variables empty.
# ELSPETH_FINGERPRINT_KEY stops being optional once any server-scoped LLM
# profile above is configured: secret use is fingerprinted into the audit
# trail and resolution fails without it.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_API_KEY=
AZURE_CONTENT_SAFETY_KEY=
AZURE_OPENAI_API_KEY=
ELSPETH_FINGERPRINT_KEY=
