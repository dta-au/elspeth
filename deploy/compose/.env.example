# From the repository root, copy this example to the repository-root .env:
#   cp deploy/compose/.env.example .env
# Keep that .env private before running the three-file bundle.
# Use an immutable sha-* or v* image tag.
IMAGE_TAG=
REGISTRY=

# Generate each independently with: openssl rand -hex 24
# Each password must be a distinct 48-character lowercase hexadecimal value.
# Bootstrap validates this before changing state. These URL-unreserved values
# enter connection URLs without ambiguous URI encoding. POSTGRES_PASSWORD is
# the cluster administrator; application URLs never use it.
POSTGRES_PASSWORD=
POSTGRES_SESSION_SCHEMA_PASSWORD=
POSTGRES_LANDSCAPE_SCHEMA_PASSWORD=
POSTGRES_SESSION_RUNTIME_PASSWORD=
POSTGRES_LANDSCAPE_RUNTIME_PASSWORD=

# Generate a JWT secret with: openssl rand -hex 32
ELSPETH_WEB_SECRET_KEY=

# Generate the share-link HMAC key with: openssl rand -base64 32
ELSPETH_WEB_SHAREABLE_LINK_SIGNING_KEY=

# Optional host-nginx bridge addressing. Change both if the default overlaps
# an existing route; the trusted forwarding peer follows this exact gateway.
ELSPETH_COMPOSE_SUBNET=172.30.85.0/24
ELSPETH_COMPOSE_GATEWAY=172.30.85.1

# Optional server-side provider credentials. Leave unused inputs empty.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_API_KEY=
AZURE_CONTENT_SAFETY_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
ELSPETH_FINGERPRINT_KEY=
