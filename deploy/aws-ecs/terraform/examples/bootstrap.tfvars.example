gateway_bearer_secret_arn                   = ""
gateway_oauth_client_id_secret_arn          = ""
gateway_oauth_client_secret_secret_arn      = ""
owner                          = "REPLACE_WITH_OWNER"
purpose                        = "ELSPETH disposable cold install"
cleanup_deadline               = "2030-01-01T00:00:00Z"
