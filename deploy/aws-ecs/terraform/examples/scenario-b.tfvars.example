run_id                  = "REPLACE_WITH_LOWERCASE_UUID"
scenario_id             = "B"
candidate_sha           = "REPLACE_WITH_FULL_GIT_SHA"
candidate_image         = "REPLACE_WITH_ELSPETH_IMAGE@sha256:REPLACE_WITH_64_HEX_DIGEST"
candidate_ecr_repository = "REPLACE_WITH_BOOTSTRAP_ECR_REPOSITORY_NAME"
rollback_baseline_sha   = "REPLACE_WITH_FULL_GIT_SHA"
rollback_baseline_image = "REPLACE_WITH_ELSPETH_IMAGE@sha256:REPLACE_WITH_64_HEX_DIGEST"
aws_account_id          = "REPLACE_WITH_12_DIGIT_ACCOUNT_ID"
aws_region              = "REPLACE_WITH_AWS_REGION"
aws_profile             = "REPLACE_WITH_AWS_PROFILE"
iam_lifecycle_aws_profile = "REPLACE_WITH_DISTINCT_IAM_LIFECYCLE_AWS_PROFILE"
iam_permissions_boundary_arn = "arn:aws:iam::REPLACE_WITH_12_DIGIT_ACCOUNT_ID:policy/elspeth-REPLACE_WITH_LOWERCASE_UUID-ecs-boundary"
target_platform         = "linux/amd64"
owner                   = "REPLACE_WITH_OWNER"
purpose                 = "ELSPETH disposable OIDC acceptance"
cleanup_deadline        = "2030-01-01T00:00:00Z"
alb_https_ingress_cidrs = ["REPLACE_WITH_OPERATOR_CIDR"]

cloudwatch_agent_image          = "REPLACE_WITH_AGENT_IMAGE@sha256:REPLACE_WITH_64_HEX_DIGEST"
cloudwatch_agent_ecr_repository = "REPLACE_WITH_BOOTSTRAP_AGENT_ECR_REPOSITORY_NAME"
composer_model         = "bedrock/REPLACE_WITH_PRIMARY_INFERENCE_PROFILE_ID"
composer_advisor_model = "bedrock/REPLACE_WITH_DISTINCT_ADVISOR_INFERENCE_PROFILE_ID"

bedrock_inference_profile_arns = [
  "arn:REPLACE_PARTITION:bedrock:REPLACE_REGION:REPLACE_ACCOUNT:inference-profile/REPLACE_PRIMARY_PROFILE",
  "arn:REPLACE_PARTITION:bedrock:REPLACE_REGION:REPLACE_ACCOUNT:inference-profile/REPLACE_ADVISOR_PROFILE",
]
bedrock_foundation_model_arns = [
  "arn:REPLACE_PARTITION:bedrock:REPLACE_REGION::foundation-model/REPLACE_PRIMARY_MODEL",
  "arn:REPLACE_PARTITION:bedrock:REPLACE_REGION::foundation-model/REPLACE_ADVISOR_MODEL",
]

scenario_tf_dir                       = "/iac/scenario-b"
scenario_tf_vars                      = "/iac/scenario-b.tfvars"
scenario_tf_binding_file              = "/iac/scenario-b.tf-binding.json"
transaction_search_baseline_sha256    = "REPLACE_WITH_TRANSACTION_SEARCH_BASELINE_SHA256"
cognito_subject_sub                   = "REPLACE_WITH_SCENARIO_B_COGNITO_SUBJECT"

database_name               = "elspeth"
session_database_name       = "elspeth_session"
landscape_database_name     = "elspeth_landscape"
aurora_engine_major_version = "16"
aurora_engine_version       = "16.13"
alarm_actions               = []

# ── Web plugin policy (all optional) ─────────────────────────────────────
#
# Leave every setting below commented out to keep the module defaults: the
# 15-plugin allowlist, both Bedrock controls set to "required", the
# standard/fast profile pair bound to the two Composer models, and Guardrails
# that screen PROMPT_ATTACK on input and the five harm categories on output.
#
# The module CREATES both Bedrock Guardrails and renders their identifiers, so
# never hand-author a guardrail_identifier for an ECS deployment; set the
# content policy here instead.

# Which LLM profiles web authors may select, keyed by the opaque alias they see.
# The task role's bedrock:InvokeModel grant is derived from these, so naming a
# third model here is sufficient — no separate IAM change is needed.
# llm_profiles = {
#   standard = { model = "bedrock/REPLACE_PRIMARY_MODEL" }
#   fast     = { model = "bedrock/REPLACE_ADVISOR_MODEL" }
# }
# default_llm_profile = "standard"

# Enforcement per control. "required" rejects a web-authored pipeline whose LLM
# nodes are not covered; "recommend" makes the control advisory and leaves the
# decision to the author. Relaxing either is a deliberate posture change.
# plugin_control_modes = {
#   prompt_shield  = "required"
#   content_safety = "required"
# }

# Optional plugins authorized on top of the always-authorized web core.
# plugin_allowlist = [
#   "source:aws_s3", "source:csv", "source:json", "source:text",
#   "sink:aws_s3", "sink:csv", "sink:json", "sink:text",
#   "transform:aws_bedrock_content_safety", "transform:aws_bedrock_prompt_shield",
#   "transform:aws_textract_document_analysis", "transform:field_mapper",
#   "transform:llm", "transform:passthrough", "transform:web_scrape",
# ]
# plugin_preferences = {
#   prompt_shield  = ["transform:aws_bedrock_prompt_shield"]
#   content_safety = ["transform:aws_bedrock_content_safety"]
# }

# Guardrail content policies. The prompt shield screens what goes INTO the
# model, content safety screens what comes OUT — hence the asymmetric
# strengths. Setting either replaces its whole filter list.
# prompt_guardrail = {
#   filters = [{ type = "PROMPT_ATTACK", input_strength = "HIGH", output_strength = "NONE" }]
# }
# content_guardrail = {
#   filters = [
#     { type = "HATE", input_strength = "NONE", output_strength = "HIGH" },
#     { type = "INSULTS", input_strength = "NONE", output_strength = "HIGH" },
#     { type = "MISCONDUCT", input_strength = "NONE", output_strength = "HIGH" },
#     { type = "SEXUAL", input_strength = "NONE", output_strength = "HIGH" },
#     { type = "VIOLENCE", input_strength = "NONE", output_strength = "HIGH" },
#   ]
# }
