{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDiscovery",
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate",
        "acm:GetCertificate",
        "acm:ListCertificates",
        "acm:ListTagsForCertificate",
        "bedrock:GetGuardrail",
        "bedrock:GetInferenceProfile",
        "bedrock:ListGuardrails",
        "bedrock:ListInferenceProfiles",
        "bedrock:ListTagsForResource",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:ListDashboards",
        "cloudwatch:ListMetrics",
        "cloudwatch:ListTagsForResource",
        "cognito-idp:Describe*",
        "cognito-idp:List*",
        "ec2:Describe*",
        "ecr:Describe*",
        "ecr:GetLifecyclePolicy",
        "ecr:List*",
        "ecs:DescribeTaskDefinition",
        "ecs:ListTaskDefinitionFamilies",
        "ecs:ListTaskDefinitions",
        "elasticfilesystem:Describe*",
        "elasticloadbalancing:Describe*",
        "events:DescribeRule",
        "events:List*",
        "iam:Get*",
        "iam:List*",
        "logs:Describe*",
        "logs:List*",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "s3:GetAccelerateConfiguration",
        "s3:GetAnalyticsConfiguration",
        "s3:GetBucket*",
        "s3:GetEncryptionConfiguration",
        "s3:GetIntelligentTieringConfiguration",
        "s3:GetInventoryConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetMetricsConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListAllMyBuckets",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetResourcePolicy",
        "secretsmanager:List*",
        "sns:GetTopicAttributes",
        "sns:List*",
        "sts:GetCallerIdentity",
        "xray:GetGroups",
        "xray:GetSamplingRules"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AuthenticateForEcrPush",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "RunScenarioTasks",
      "Effect": "Allow",
      "Action": [
        "ecs:RunTask"
      ],
      "Resource": [
        "arn:aws:ecs:${aws_region}:${aws_account_id}:task-definition/${scenario_a_namespace}-*:*",
        "arn:aws:ecs:${aws_region}:${aws_account_id}:task-definition/${scenario_b_namespace}-*:*"
      ],
      "Condition": {
        "ArnLike": {
          "ecs:cluster": [
            "arn:aws:ecs:${aws_region}:${aws_account_id}:cluster/acceptance-${scenario_a_namespace}-cluster",
            "arn:aws:ecs:${aws_region}:${aws_account_id}:cluster/acceptance-${scenario_b_namespace}-cluster"
          ]
        },
        "StringEquals": {
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "StopRunScenarioTasks",
      "Effect": "Allow",
      "Action": [
        "ecs:StopTask"
      ],
      "Resource": [
        "arn:aws:ecs:${aws_region}:${aws_account_id}:task/acceptance-${scenario_a_namespace}-cluster/*",
        "arn:aws:ecs:${aws_region}:${aws_account_id}:task/acceptance-${scenario_b_namespace}-cluster/*"
      ],
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": [
            "arn:aws:ecs:${aws_region}:${aws_account_id}:cluster/acceptance-${scenario_a_namespace}-cluster",
            "arn:aws:ecs:${aws_region}:${aws_account_id}:cluster/acceptance-${scenario_b_namespace}-cluster"
          ]
        },
        "StringEquals": {
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "ReadScenarioSecretValues",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:${aws_region}:${aws_account_id}:secret:${scenario_a_namespace}-*",
        "arn:aws:secretsmanager:${aws_region}:${aws_account_id}:secret:${scenario_b_namespace}-*"
      ]
    },
    {
      "Sid": "ManageRunScopedInlinePolicies",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRolePolicy",
        "iam:PutRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::${aws_account_id}:role/elspeth/${run_id}/${scenario_a_namespace}-task-role",
        "arn:aws:iam::${aws_account_id}:role/elspeth/${run_id}/${scenario_a_namespace}-execution-role",
        "arn:aws:iam::${aws_account_id}:role/elspeth/${run_id}/${scenario_b_namespace}-task-role",
        "arn:aws:iam::${aws_account_id}:role/elspeth/${run_id}/${scenario_b_namespace}-execution-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}"
        }
      }
    },
    {
      "Sid": "ManageKnownExecutionRoleAttachment",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::${aws_account_id}:role/elspeth/${run_id}/${scenario_a_namespace}-execution-role",
        "arn:aws:iam::${aws_account_id}:role/elspeth/${run_id}/${scenario_b_namespace}-execution-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}"
        },
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        }
      }
    },
    {
      "Sid": "PassRunScopedRolesToEcsTasksOnly",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::${aws_account_id}:role/elspeth/${run_id}/${scenario_a_namespace}-task-role",
        "arn:aws:iam::${aws_account_id}:role/elspeth/${run_id}/${scenario_a_namespace}-execution-role",
        "arn:aws:iam::${aws_account_id}:role/elspeth/${run_id}/${scenario_b_namespace}-task-role",
        "arn:aws:iam::${aws_account_id}:role/elspeth/${run_id}/${scenario_b_namespace}-execution-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "CreateRequiredServiceLinkedRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": [
        "arn:aws:iam::${aws_account_id}:role/aws-service-role/ecs.amazonaws.com/*",
        "arn:aws:iam::${aws_account_id}:role/aws-service-role/elasticloadbalancing.amazonaws.com/*",
        "arn:aws:iam::${aws_account_id}:role/aws-service-role/rds.amazonaws.com/*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "rds.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DedicatedAccountOnlyUntaggedMutations",
      "Effect": "Allow",
      "Action": [
        "logs:DeleteResourcePolicy",
        "logs:PutResourcePolicy"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    }
  ]
}
