{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageElspethNamedBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:DeleteBucketOwnershipControls",
        "s3:DeleteBucketPolicy",
        "s3:DeleteBucketPublicAccessBlock",
        "s3:DeleteBucketTagging",
        "s3:DeleteBucketWebsite",
        "s3:ListBucketVersions",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPolicy",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::${backend_state_bucket}",
        "arn:aws:s3:::${scenario_a_bucket}",
        "arn:aws:s3:::${scenario_b_bucket}"
      ]
    },
    {
      "Sid": "ManageElspethNamedBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::${backend_state_bucket}/*",
        "arn:aws:s3:::${scenario_a_bucket}/*",
        "arn:aws:s3:::${scenario_b_bucket}/*"
      ]
    },
    {
      "Sid": "ManageRunEc2NetworkRelationships",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateRouteTable",
        "ec2:AttachInternetGateway",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:DetachInternetGateway",
        "ec2:DisassociateRouteTable",
        "ec2:ModifySubnetAttribute",
        "ec2:ModifyVpcAttribute",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": [
        "arn:aws:ec2:${aws_region}:${aws_account_id}:internet-gateway/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:route-table/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:security-group/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:subnet/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "AuthorizeOnRunSecurityGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress"
      ],
      "Resource": "arn:aws:ec2:${aws_region}:${aws_account_id}:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "CreateRunTaggedSecurityGroupRules",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress"
      ],
      "Resource": "arn:aws:ec2:${aws_region}:${aws_account_id}:security-group-rule/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "TagNewRunEc2Resources",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}",
          "ec2:CreateAction": [
            "AuthorizeSecurityGroupEgress",
            "AuthorizeSecurityGroupIngress",
            "CreateInternetGateway",
            "CreateRouteTable",
            "CreateSecurityGroup",
            "CreateSubnet",
            "CreateVpc"
          ]
        }
      }
    },
    {
      "Sid": "ManageRunCognitoChildren",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminCreateUser",
        "cognito-idp:AdminGetUser",
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:CreateUserPoolDomain",
        "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:DeleteUserPoolDomain"
      ],
      "Resource": "arn:aws:cognito-idp:${aws_region}:${aws_account_id}:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "ManageRunEfsMountTargets",
      "Effect": "Allow",
      "Action": [
        "elasticfilesystem:CreateMountTarget",
        "elasticfilesystem:DeleteMountTarget"
      ],
      "Resource": "arn:aws:elasticfilesystem:${aws_region}:${aws_account_id}:file-system/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "ManageRunEfsLifecycleConfiguration",
      "Effect": "Allow",
      "Action": [
        "elasticfilesystem:PutLifecycleConfiguration"
      ],
      "Resource": "arn:aws:elasticfilesystem:${aws_region}:${aws_account_id}:file-system/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "ManageRunEventTargets",
      "Effect": "Allow",
      "Action": [
        "events:PutTargets",
        "events:RemoveTargets"
      ],
      "Resource": [
        "arn:aws:events:${aws_region}:${aws_account_id}:rule/a-*",
        "arn:aws:events:${aws_region}:${aws_account_id}:rule/b-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    }
  ]
}
