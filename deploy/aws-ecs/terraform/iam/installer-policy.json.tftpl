{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDiscovery",
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate",
        "acm:GetCertificate",
        "acm:ListCertificates",
        "acm:ListTagsForCertificate",
        "bedrock:GetGuardrail",
        "bedrock:ListGuardrails",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:ListDashboards",
        "cloudwatch:ListMetrics",
        "cloudwatch:ListTagsForResource",
        "cognito-idp:Describe*",
        "cognito-idp:List*",
        "ec2:Describe*",
        "ecr:Describe*",
        "ecr:GetLifecyclePolicy",
        "ecr:List*",
        "ecs:Describe*",
        "ecs:List*",
        "elasticfilesystem:Describe*",
        "elasticloadbalancing:Describe*",
        "events:DescribeRule",
        "events:List*",
        "iam:Get*",
        "iam:List*",
        "logs:Describe*",
        "logs:GetLogEvents",
        "logs:List*",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "s3:GetBucket*",
        "s3:GetEncryptionConfiguration",
        "s3:ListAllMyBuckets",
        "s3:ListBucket",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetResourcePolicy",
        "secretsmanager:List*",
        "sns:GetTopicAttributes",
        "sns:List*",
        "sts:GetCallerIdentity",
        "xray:Get*",
        "xray:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PushAndCleanElspethImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchDeleteImage",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": [
        "arn:aws:ecr:${aws_region}:${aws_account_id}:repository/${ecr_repository}",
        "arn:aws:ecr:${aws_region}:${aws_account_id}:repository/${cloudwatch_agent_ecr_repository}"
      ]
    },
    {
      "Sid": "AuthenticateForEcrPush",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "RunScenarioTasks",
      "Effect": "Allow",
      "Action": [
        "ecs:RunTask"
      ],
      "Resource": [
        "arn:aws:ecs:${aws_region}:${aws_account_id}:task-definition/a-*:*",
        "arn:aws:ecs:${aws_region}:${aws_account_id}:task-definition/b-*:*"
      ],
      "Condition": {
        "ArnLike": {
          "ecs:cluster": [
            "arn:aws:ecs:${aws_region}:${aws_account_id}:cluster/acceptance-a-*",
            "arn:aws:ecs:${aws_region}:${aws_account_id}:cluster/acceptance-b-*"
          ]
        },
        "StringEquals": {
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "ReadScenarioSecretValues",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:${aws_region}:${aws_account_id}:secret:a-*",
        "arn:aws:secretsmanager:${aws_region}:${aws_account_id}:secret:b-*"
      ]
    },
    {
      "Sid": "CreateRunScopedRolesWithBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:TagRole"
      ],
      "Resource": [
        "arn:aws:iam::${aws_account_id}:role/a-*-task-role",
        "arn:aws:iam::${aws_account_id}:role/a-*-execution-role",
        "arn:aws:iam::${aws_account_id}:role/b-*-task-role",
        "arn:aws:iam::${aws_account_id}:role/b-*-execution-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "iam:PermissionsBoundary": "arn:aws:iam::aws:policy/PowerUserAccess"
        }
      }
    },
    {
      "Sid": "ManageRunScopedRoles",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DeleteRolePermissionsBoundary",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::${aws_account_id}:role/a-*-task-role",
        "arn:aws:iam::${aws_account_id}:role/a-*-execution-role",
        "arn:aws:iam::${aws_account_id}:role/b-*-task-role",
        "arn:aws:iam::${aws_account_id}:role/b-*-execution-role"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}"
        }
      }
    },
    {
      "Sid": "PassRunScopedRolesToEcsTasksOnly",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::${aws_account_id}:role/a-*-task-role",
        "arn:aws:iam::${aws_account_id}:role/a-*-execution-role",
        "arn:aws:iam::${aws_account_id}:role/b-*-task-role",
        "arn:aws:iam::${aws_account_id}:role/b-*-execution-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com",
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}"
        }
      }
    },
    {
      "Sid": "CreateRequiredServiceLinkedRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": [
        "arn:aws:iam::${aws_account_id}:role/aws-service-role/ecs.amazonaws.com/*",
        "arn:aws:iam::${aws_account_id}:role/aws-service-role/elasticloadbalancing.amazonaws.com/*",
        "arn:aws:iam::${aws_account_id}:role/aws-service-role/rds.amazonaws.com/*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "rds.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ManageRunDashboards",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DeleteDashboards",
        "cloudwatch:PutDashboard"
      ],
      "Resource": [
        "arn:aws:cloudwatch::${aws_account_id}:dashboard/a-*",
        "arn:aws:cloudwatch::${aws_account_id}:dashboard/b-*"
      ]
    },
    {
      "Sid": "CreateRunTaggedRegionalResources",
      "Effect": "Allow",
      "Action": [
        "acm:ImportCertificate",
        "bedrock:CreateGuardrail",
        "cloudwatch:PutMetricAlarm",
        "cognito-idp:CreateUserPool",
        "ec2:CreateInternetGateway",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateSubnet",
        "ec2:CreateVpc",
        "ecr:CreateRepository",
        "ecs:CreateCluster",
        "ecs:CreateService",
        "ecs:RegisterTaskDefinition",
        "elasticfilesystem:CreateAccessPoint",
        "elasticfilesystem:CreateFileSystem",
        "elasticloadbalancing:CreateLoadBalancer",
        "elasticloadbalancing:CreateListener",
        "elasticloadbalancing:CreateRule",
        "elasticloadbalancing:CreateTargetGroup",
        "events:PutRule",
        "logs:CreateLogGroup",
        "rds:CreateDBCluster",
        "rds:CreateDBInstance",
        "rds:CreateDBSubnetGroup",
        "secretsmanager:CreateSecret",
        "sns:CreateTopic"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "MutateRunTaggedRegionalResources",
      "Effect": "Allow",
      "Action": [
        "acm:AddTagsToCertificate",
        "acm:DeleteCertificate",
        "acm:RemoveTagsFromCertificate",
        "bedrock:CreateGuardrailVersion",
        "bedrock:DeleteGuardrail",
        "bedrock:TagResource",
        "bedrock:UntagResource",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource",
        "cognito-idp:DeleteUserPool",
        "cognito-idp:TagResource",
        "cognito-idp:UntagResource",
        "cognito-idp:UpdateUserPool",
        "ec2:CreateTags",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteRouteTable",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteSubnet",
        "ec2:DeleteTags",
        "ec2:DeleteVpc",
        "ecr:DeleteLifecyclePolicy",
        "ecr:DeleteRepository",
        "ecr:PutImageScanningConfiguration",
        "ecr:PutImageTagMutability",
        "ecr:PutLifecyclePolicy",
        "ecr:TagResource",
        "ecr:UntagResource",
        "ecs:DeleteCluster",
        "ecs:DeleteService",
        "ecs:DeregisterTaskDefinition",
        "ecs:TagResource",
        "ecs:UntagResource",
        "ecs:UpdateClusterSettings",
        "ecs:UpdateService",
        "elasticfilesystem:DeleteAccessPoint",
        "elasticfilesystem:DeleteFileSystem",
        "elasticfilesystem:TagResource",
        "elasticfilesystem:UntagResource",
        "elasticloadbalancing:AddTags",
        "elasticloadbalancing:DeleteLoadBalancer",
        "elasticloadbalancing:DeleteListener",
        "elasticloadbalancing:DeleteRule",
        "elasticloadbalancing:DeleteTargetGroup",
        "elasticloadbalancing:ModifyListener",
        "elasticloadbalancing:ModifyLoadBalancerAttributes",
        "elasticloadbalancing:ModifyRule",
        "elasticloadbalancing:ModifyTargetGroup",
        "elasticloadbalancing:ModifyTargetGroupAttributes",
        "elasticloadbalancing:RemoveTags",
        "events:DeleteRule",
        "events:TagResource",
        "events:UntagResource",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "rds:AddTagsToResource",
        "rds:DeleteDBCluster",
        "rds:DeleteDBInstance",
        "rds:DeleteDBSubnetGroup",
        "rds:ModifyDBCluster",
        "rds:ModifyDBInstance",
        "rds:ModifyDBSubnetGroup",
        "rds:RemoveTagsFromResource",
        "secretsmanager:DeleteSecret",
        "secretsmanager:PutSecretValue",
        "secretsmanager:TagResource",
        "secretsmanager:UntagResource",
        "secretsmanager:UpdateSecret",
        "sns:DeleteTopic",
        "sns:SetTopicAttributes",
        "sns:TagResource",
        "sns:UntagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "ManageElspethNamedBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:DeleteBucketEncryption",
        "s3:DeleteBucketOwnershipControls",
        "s3:DeleteBucketPolicy",
        "s3:DeleteBucketPublicAccessBlock",
        "s3:DeleteBucketTagging",
        "s3:DeleteBucketWebsite",
        "s3:ListBucketVersions",
        "s3:PutBucketEncryption",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::${backend_state_bucket}",
        "arn:aws:s3:::${scenario_a_bucket}",
        "arn:aws:s3:::${scenario_b_bucket}"
      ]
    },
    {
      "Sid": "ManageElspethNamedBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::${backend_state_bucket}/*",
        "arn:aws:s3:::${scenario_a_bucket}/*",
        "arn:aws:s3:::${scenario_b_bucket}/*"
      ]
    },
    {
      "Sid": "ManageRunEc2NetworkRelationships",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateRouteTable",
        "ec2:AttachInternetGateway",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:DetachInternetGateway",
        "ec2:DisassociateRouteTable",
        "ec2:ModifyVpcAttribute",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": [
        "arn:aws:ec2:${aws_region}:${aws_account_id}:internet-gateway/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:route-table/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:security-group/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:subnet/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "AuthorizeOnRunSecurityGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress"
      ],
      "Resource": "arn:aws:ec2:${aws_region}:${aws_account_id}:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "CreateRunTaggedSecurityGroupRules",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress"
      ],
      "Resource": "arn:aws:ec2:${aws_region}:${aws_account_id}:security-group-rule/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "TagNewRunEc2Resources",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "ManageRunCognitoChildren",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:CreateUserPoolDomain",
        "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:DeleteUserPoolDomain"
      ],
      "Resource": "arn:aws:cognito-idp:${aws_region}:${aws_account_id}:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "ManageRunEfsMountTargets",
      "Effect": "Allow",
      "Action": [
        "elasticfilesystem:CreateMountTarget",
        "elasticfilesystem:DeleteMountTarget"
      ],
      "Resource": "arn:aws:elasticfilesystem:${aws_region}:${aws_account_id}:file-system/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "ManageRunEventTargets",
      "Effect": "Allow",
      "Action": [
        "events:PutTargets",
        "events:RemoveTargets"
      ],
      "Resource": [
        "arn:aws:events:${aws_region}:${aws_account_id}:rule/a-*",
        "arn:aws:events:${aws_region}:${aws_account_id}:rule/b-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "CreateRunTaggedXrayResources",
      "Effect": "Allow",
      "Action": [
        "xray:CreateGroup",
        "xray:CreateSamplingRule"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "MutateRunTaggedXrayResources",
      "Effect": "Allow",
      "Action": [
        "xray:DeleteGroup",
        "xray:DeleteSamplingRule",
        "xray:TagResource",
        "xray:UntagResource",
        "xray:UpdateGroup",
        "xray:UpdateSamplingRule"
      ],
      "Resource": [
        "arn:aws:xray:${aws_region}:${aws_account_id}:group/a-*/*",
        "arn:aws:xray:${aws_region}:${aws_account_id}:group/b-*/*",
        "arn:aws:xray:${aws_region}:${aws_account_id}:sampling-rule/a-*",
        "arn:aws:xray:${aws_region}:${aws_account_id}:sampling-rule/b-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ACCEPTANCE_RUN_ID": "${run_id}",
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "DedicatedAccountOnlyUntaggedMutations",
      "Effect": "Allow",
      "Action": [
        "logs:DeleteResourcePolicy",
        "logs:PutResourcePolicy"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    }
  ]
}
