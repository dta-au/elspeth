{
  "format": "elspeth-composer-edit-plan/2",
  "name": "composer-gold-50",
  "description": "Fifty small edits in a row for a large graph whose prompts are all held in files; four more run when the graph has a csv source without skip_rows or a step with a secret reference (and --target spare_secret=NAME). Leaves the graph as found.",
  "forbidden_tools": [
    "set_pipeline"
  ],
  "targets": {
    "source": {
      "kind": "first_source"
    },
    "head": {
      "kind": "consumer_of",
      "target": "source"
    },
    "llm_file": {
      "kind": "llm_node",
      "prompt": "file"
    },
    "output": {
      "kind": "first_output"
    },
    "csv_source": {
      "kind": "source_without_option",
      "plugin": "csv",
      "option": "skip_rows",
      "optional": true
    },
    "secret_node": {
      "kind": "secret_holder",
      "optional": true
    },
    "secret_option": {
      "kind": "secret_option_of",
      "target": "secret_node",
      "optional": true
    },
    "secret_name": {
      "kind": "secret_name_of",
      "target": "secret_node",
      "optional": true
    },
    "spare_secret": {
      "kind": "operator",
      "optional": true
    }
  },
  "edits": [
    {
      "id": "rename-pipeline",
      "message": "Set the pipeline name to \"Battery check\".",
      "expect": [
        {
          "equals": "/metadata/name",
          "value": "Battery check"
        }
      ],
      "tools_any": [
        "set_metadata"
      ]
    },
    {
      "id": "pipeline-description",
      "message": "Set the pipeline description to \"Edited by the Composer edit battery.\".",
      "expect": [
        {
          "equals": "/metadata/description",
          "value": "Edited by the Composer edit battery."
        }
      ],
      "tools_any": [
        "set_metadata"
      ]
    },
    {
      "id": "insert-a",
      "message": "Insert a passthrough transform with the id battery_a between {source} and {head}, and discard any rows that fail in it.",
      "expect": [
        {
          "new_node": "battery_a",
          "fields": {
            "plugin": "passthrough",
            "node_type": "transform",
            "on_error": "discard"
          },
          "option_keys": [
            "schema",
            "required_input_fields"
          ]
        },
        {
          "chain": {
            "from": "{source}",
            "to": "{head}",
            "via": [
              "battery_a"
            ]
          }
        }
      ],
      "tools_any": [
        "splice_transform",
        "upsert_node"
      ]
    },
    {
      "id": "describe-a",
      "message": "Set the description of the step battery_a to \"Battery step A.\".",
      "expect": [
        {
          "equals": "/nodes/battery_a/description",
          "value": "Battery step A."
        }
      ],
      "tools_any": [
        "upsert_node"
      ]
    },
    {
      "id": "insert-b",
      "message": "Insert a passthrough transform with the id battery_b between battery_a and {head}, and discard any rows that fail in it.",
      "expect": [
        {
          "new_node": "battery_b",
          "fields": {
            "plugin": "passthrough",
            "node_type": "transform",
            "on_error": "discard"
          },
          "option_keys": [
            "schema",
            "required_input_fields"
          ]
        },
        {
          "chain": {
            "from": "{source}",
            "to": "{head}",
            "via": [
              "battery_a",
              "battery_b"
            ]
          }
        }
      ],
      "tools_any": [
        "splice_transform",
        "upsert_node"
      ]
    },
    {
      "id": "insert-c",
      "message": "Insert a passthrough transform with the id battery_c between {source} and battery_a, and discard any rows that fail in it.",
      "expect": [
        {
          "new_node": "battery_c",
          "fields": {
            "plugin": "passthrough",
            "node_type": "transform",
            "on_error": "discard"
          },
          "option_keys": [
            "schema",
            "required_input_fields"
          ]
        },
        {
          "chain": {
            "from": "{source}",
            "to": "{head}",
            "via": [
              "battery_c",
              "battery_a",
              "battery_b"
            ]
          }
        }
      ],
      "tools_any": [
        "splice_transform",
        "upsert_node"
      ]
    },
    {
      "id": "describe-head",
      "message": "Set the description of the step {head} to \"Battery-edited description.\".",
      "expect": [
        {
          "equals": "/nodes/{head}/description",
          "value": "Battery-edited description."
        }
      ],
      "tools_any": [
        "upsert_node"
      ]
    },
    {
      "id": "move-c",
      "message": "Move battery_c so the order is {source}, battery_a, battery_c, battery_b, {head}.",
      "expect": [
        {
          "chain": {
            "from": "{source}",
            "to": "{head}",
            "via": [
              "battery_a",
              "battery_c",
              "battery_b"
            ]
          }
        }
      ],
      "tools_any": [
        "upsert_node",
        "upsert_edge",
        "remove_edge",
        "splice_transform"
      ]
    },
    {
      "id": "rename-b",
      "message": "Rename the step battery_b to battery_d, keeping its place in the pipeline and all of its settings.",
      "expect": [
        {
          "renamed_node": {
            "from": "battery_b",
            "to": "battery_d"
          }
        },
        {
          "chain": {
            "from": "{source}",
            "to": "{head}",
            "via": [
              "battery_a",
              "battery_c",
              "battery_d"
            ]
          }
        }
      ],
      "tools_any": [
        "upsert_node",
        "remove_node"
      ]
    },
    {
      "id": "describe-d",
      "message": "Set the description of the step battery_d to \"Battery step D.\".",
      "expect": [
        {
          "equals": "/nodes/battery_d/description",
          "value": "Battery step D."
        }
      ],
      "tools_any": [
        "upsert_node"
      ]
    },
    {
      "id": "add-output",
      "message": "Add an output named battery_out that writes rows as JSON lines to the file battery_out.jsonl and discards any rows it cannot write, and send the rows that fail in battery_d to it.",
      "expect": [
        {
          "new_output": "battery_out",
          "fields": {
            "plugin": "json",
            "on_write_failure": "discard"
          },
          "options": {
            "path": {
              "ends_with": "battery_out.jsonl"
            }
          },
          "option_keys": [
            "path",
            "format",
            "mode",
            "schema",
            "indent",
            "encoding",
            "collision_policy"
          ]
        },
        {
          "equals": "/nodes/battery_d/on_error",
          "value": "battery_out"
        }
      ],
      "tools_any": [
        "set_output"
      ],
      "edges_touching": [
        "battery_d"
      ]
    },
    {
      "id": "output-path",
      "message": "Change the output battery_out to write to the file battery_errors.jsonl instead, keeping its other settings.",
      "expect": [
        {
          "ends_with": "/outputs/battery_out/options/path",
          "value": "battery_errors.jsonl"
        }
      ],
      "tools_any": [
        "patch_output_options",
        "set_output"
      ]
    },
    {
      "id": "route-c-errors",
      "message": "Send the rows that fail in battery_c to the output battery_out as well.",
      "expect": [
        {
          "equals": "/nodes/battery_c/on_error",
          "value": "battery_out"
        }
      ],
      "tools_any": [
        "upsert_edge",
        "upsert_node"
      ],
      "edges_touching": [
        "battery_c",
        "battery_out"
      ]
    },
    {
      "id": "route-a-errors",
      "message": "Send the rows that fail in battery_a to the output battery_out as well.",
      "expect": [
        {
          "equals": "/nodes/battery_a/on_error",
          "value": "battery_out"
        }
      ],
      "tools_any": [
        "upsert_edge",
        "upsert_node"
      ],
      "edges_touching": [
        "battery_a",
        "battery_out"
      ]
    },
    {
      "id": "describe-output",
      "message": "Set the description of the output battery_out to \"Rows that failed in battery steps.\"",
      "expect": [
        {
          "equals": "/outputs/battery_out/description",
          "value": "Rows that failed in battery steps."
        }
      ],
      "tools_any": [
        "set_output"
      ]
    },
    {
      "id": "unroute-a-errors",
      "message": "Stop sending the rows that fail in battery_a to battery_out; discard them instead.",
      "expect": [
        {
          "equals": "/nodes/battery_a/on_error",
          "value": "discard"
        }
      ],
      "tools_any": [
        "remove_edge",
        "upsert_node",
        "upsert_edge"
      ],
      "edges_touching": [
        "battery_a",
        "battery_out"
      ]
    },
    {
      "id": "describe-llm",
      "message": "Set the description of the step {llm_file} to \"Battery-edited LLM step.\".",
      "expect": [
        {
          "equals": "/nodes/{llm_file}/description",
          "value": "Battery-edited LLM step."
        }
      ],
      "tools_any": [
        "upsert_node"
      ]
    },
    {
      "id": "max-tokens",
      "message": "Set max_tokens on {llm_file} to 1237.",
      "expect": [
        {
          "equals": "/nodes/{llm_file}/options/max_tokens",
          "value": 1237
        }
      ],
      "tools_any": [
        "patch_node_options",
        "upsert_node"
      ]
    },
    {
      "id": "temperature",
      "message": "Set temperature on {llm_file} to 0.37.",
      "expect": [
        {
          "equals": "/nodes/{llm_file}/options/temperature",
          "value": 0.37
        }
      ],
      "tools_any": [
        "patch_node_options",
        "upsert_node"
      ]
    },
    {
      "id": "restore-max-tokens",
      "message": "Put max_tokens on {llm_file} back to {was:/nodes/{llm_file}/options/max_tokens}.",
      "expect": [
        {
          "restored": "/nodes/{llm_file}/options/max_tokens"
        }
      ],
      "tools_any": [
        "patch_node_options",
        "upsert_node"
      ]
    },
    {
      "id": "restore-temperature",
      "message": "Put temperature on {llm_file} back to {was:/nodes/{llm_file}/options/temperature}.",
      "expect": [
        {
          "restored": "/nodes/{llm_file}/options/temperature"
        }
      ],
      "tools_any": [
        "patch_node_options",
        "upsert_node"
      ]
    },
    {
      "id": "file-new-1",
      "message": "Put the prompt of {llm_file} into a new prompt file named battery_prompt_1.txt holding the same text with the sentence \"Battery file marker one.\" added at the end, and use that file for the step.",
      "expect": [
        {
          "text": "/nodes/{llm_file}/options/prompt_template",
          "append": "Battery file marker one.",
          "form": "file"
        }
      ],
      "tools_all": [
        "create_blob",
        "wire_blob_inline_ref"
      ],
      "approve": {
        "kind": "llm_prompt_template",
        "node": "{llm_file}"
      }
    },
    {
      "id": "file-change-1",
      "message": "In the prompt file used by {llm_file}, change \"Battery file marker one.\" to \"Battery file marker two.\".",
      "expect": [
        {
          "text": "/nodes/{llm_file}/options/prompt_template",
          "replace": [
            "Battery file marker one.",
            "Battery file marker two."
          ],
          "form": "file"
        }
      ],
      "tools_any": [
        "wire_blob_inline_ref"
      ],
      "approve": {
        "kind": "llm_prompt_template",
        "node": "{llm_file}"
      }
    },
    {
      "id": "file-remove-1",
      "message": "Remove the sentence \"Battery file marker two.\" from the prompt file used by {llm_file}.",
      "expect": [
        {
          "text": "/nodes/{llm_file}/options/prompt_template",
          "remove": "Battery file marker two.",
          "form": "file"
        }
      ],
      "tools_any": [
        "wire_blob_inline_ref"
      ],
      "approve": {
        "kind": "llm_prompt_template",
        "node": "{llm_file}"
      }
    },
    {
      "id": "unroute-c-errors",
      "message": "Stop sending the rows that fail in battery_c to battery_out; discard them instead.",
      "expect": [
        {
          "equals": "/nodes/battery_c/on_error",
          "value": "discard"
        }
      ],
      "tools_any": [
        "remove_edge",
        "upsert_node",
        "upsert_edge"
      ],
      "edges_touching": [
        "battery_c",
        "battery_out"
      ]
    },
    {
      "id": "remove-output",
      "message": "Discard the rows that fail in battery_d, and remove the output battery_out.",
      "expect": [
        {
          "absent": "/outputs/battery_out"
        },
        {
          "equals": "/nodes/battery_d/on_error",
          "value": "discard"
        }
      ],
      "tools_any": [
        "remove_output"
      ],
      "edges_touching": [
        "battery_d"
      ]
    },
    {
      "id": "remove-c",
      "message": "Remove the step battery_c and connect battery_a directly to battery_d.",
      "expect": [
        {
          "absent": "/nodes/battery_c"
        },
        {
          "chain": {
            "from": "{source}",
            "to": "{head}",
            "via": [
              "battery_a",
              "battery_d"
            ]
          }
        }
      ],
      "tools_any": [
        "remove_node"
      ]
    },
    {
      "id": "remove-d",
      "message": "Remove the step battery_d and connect battery_a directly to {head}.",
      "expect": [
        {
          "absent": "/nodes/battery_d"
        },
        {
          "chain": {
            "from": "{source}",
            "to": "{head}",
            "via": [
              "battery_a"
            ]
          }
        }
      ],
      "tools_any": [
        "remove_node"
      ]
    },
    {
      "id": "remove-a",
      "message": "Remove the step battery_a and connect {source} directly to {head}.",
      "expect": [
        {
          "absent": "/nodes/battery_a"
        },
        {
          "chain": {
            "from": "{source}",
            "to": "{head}",
            "via": []
          }
        }
      ],
      "tools_any": [
        "remove_node"
      ]
    },
    {
      "id": "insert-e",
      "message": "Insert a passthrough transform with the id battery_e between {source} and {head}, and discard any rows that fail in it.",
      "expect": [
        {
