{
  "format": "elspeth-composer-edit-plan/2",
  "name": "composer-file-bindings",
  "description": "Connect and reconnect files, from an empty pipeline: a source re-pointed at three other files, a reference join re-pointed three times, an LLM step whose prompt and system prompt are bound to files and re-bound (uploaded files and files the Composer writes), a query template, a file_inject entry and a named reference table each bound and re-bound twice, a one-row-per-file source re-pointed once, then every component removed. The battery uploads each file as the user would before the message that names it.",
  "start": "empty",
  "pass_rule": "all_passed_as_found",
  "forbidden_tools": [
    "set_pipeline"
  ],
  "targets": {},
  "edits": [
    {
      "id": "create-source-and-sink",
      "message": "Read the uploaded file orders_a.csv as the pipeline's source, and add an output named battery_out that writes every row as JSON lines to the file battery_results.jsonl and discards any rows it cannot write. Connect the source straight to battery_out.",
      "expect": [
        {
          "equals": "/sources/source/plugin",
          "value": "csv"
        },
        {
          "bound": "/sources/source/options/blob_ref",
          "file": "orders_a.csv"
        },
        {
          "new_output": "battery_out",
          "fields": {
            "plugin": "json",
            "on_write_failure": "discard"
          },
          "options": {
            "path": {
              "ends_with": "battery_results.jsonl"
            }
          },
          "option_keys": [
            "path",
            "format",
            "mode",
            "schema",
            "indent",
            "encoding",
            "collision_policy",
            "headers"
          ]
        },
        {
          "chain": {
            "from": "source",
            "to": "battery_out",
            "via": []
          }
        },
        {
          "files": [
            "orders_a.csv"
          ]
        }
      ],
      "attach": [
        "orders_a.csv"
      ],
      "may_change": [
        "/sources/source"
      ],
      "edges_touching": [
        "source",
        "battery_out"
      ],
      "tools_all": [
        "set_source_from_blob",
        "set_output"
      ]
    },
    {
      "id": "source-to-orders-b",
      "message": "Use the uploaded file orders_b.csv as the source's file instead of orders_a.csv.",
      "expect": [
        {
          "bound": "/sources/source/options/blob_ref",
          "file": "orders_b.csv"
        },
        {
          "files": [
            "orders_b.csv"
          ]
        }
      ],
      "attach": [
        "orders_b.csv"
      ],
      "tools_any": [
        "set_source_from_blob"
      ]
    },
    {
      "id": "source-to-orders-c",
      "message": "Use the uploaded file orders_c.csv as the source's file instead of orders_b.csv.",
      "expect": [
        {
          "bound": "/sources/source/options/blob_ref",
          "file": "orders_c.csv"
        },
        {
          "files": [
            "orders_c.csv"
          ]
        }
      ],
      "attach": [
        "orders_c.csv"
      ],
      "tools_any": [
        "set_source_from_blob"
      ]
    },
    {
      "id": "source-to-orders-d",
      "message": "Use the uploaded file orders_d.csv as the source's file instead of orders_c.csv.",
      "expect": [
        {
          "bound": "/sources/source/options/blob_ref",
          "file": "orders_d.csv"
        },
        {
          "files": [
            "orders_d.csv"
          ]
        }
      ],
      "attach": [
        "orders_d.csv"
      ],
      "tools_any": [
        "set_source_from_blob"
      ]
    },
    {
      "id": "sink-to-results-2",
      "message": "Make the output battery_out write to the file battery_results_2.jsonl instead of battery_results.jsonl.",
      "expect": [
        {
          "ends_with": "/outputs/battery_out/options/path",
          "value": "battery_results_2.jsonl"
        }
      ],
      "tools_any": [
        "patch_output_options",
        "set_output"
      ]
    },
    {
      "id": "add-reference-join",
      "message": "Add a reference join step named battery_regions between the source and battery_out that looks up each row's region_code in the uploaded file regions_a.csv (CSV, key column region_code) and adds that entry's region_name as a field named region_name. Write null when there is no match, and discard any rows that fail in it.",
      "expect": [
        {
          "new_node": "battery_regions",
          "fields": {
            "plugin": "reference_join",
            "node_type": "transform",
            "on_error": "discard"
          },
          "option_keys": [
            "default_values",
            "key_field",
            "lookups",
            "on_miss",
            "output",
            "reference_content",
            "reference_format",
            "reference_key_name",
            "reference_source",
            "required_input_fields",
            "schema",
            "tables"
          ]
        },
        {
          "bound": "/nodes/battery_regions/options/reference_content",
          "file": "regions_a.csv"
        },
        {
          "chain": {
            "from": "source",
            "to": "battery_out",
            "via": [
              "battery_regions"
            ]
          }
        },
        {
          "files": [
            "orders_d.csv",
            "regions_a.csv"
          ]
        }
      ],
      "attach": [
        "regions_a.csv"
      ],
      "tools_any": [
        "splice_transform",
        "upsert_node"
      ],
      "tools_all": [
        "wire_blob_inline_ref"
      ]
    },
    {
      "id": "reference-to-regions-b",
      "message": "Use the uploaded file regions_b.csv as the reference table of the step battery_regions instead of regions_a.csv.",
      "expect": [
        {
          "bound": "/nodes/battery_regions/options/reference_content",
          "file": "regions_b.csv"
        },
        {
          "files": [
            "orders_d.csv",
            "regions_b.csv"
          ]
        }
      ],
      "attach": [
        "regions_b.csv"
      ],
      "tools_any": [
        "wire_blob_inline_ref"
      ]
    },
    {
      "id": "reference-to-regions-c",
