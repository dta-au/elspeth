{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elspeth.dev/schemas/power-automate/v1/write",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "elspeth.power-automate.v1"
    },
    "operation": {
      "const": "write"
    },
    "delivery_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "protocol",
    "operation",
    "delivery_id",
    "payload_sha256",
    "data"
  ],
  "additionalProperties": false
}
