      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-maxUtf8Bytes": 256,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  },
  "required": [
    "protocol",
    "operation",
    "query",
    "snapshot_id",
    "cursor",
    "page_size"
  ],
  "additionalProperties": false,
