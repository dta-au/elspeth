      },
      "additionalProperties": {
        "$ref": "#/$defs/credentialFreeValue"
      }
    },
    "credentialFreeValue": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number"
          ]
        },
        {
          "type": "string",
          "not": {
            "pattern": "\\$\\{"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/credentialFreeValue"
          }
        },
        {
          "$ref": "#/$defs/credentialFreeObject"
        }
      ]
    }
  },
  "description": "Read request with recursive credential-free query data. UTF-8 identifier byte limits and maximum JSON depth 64 are supplementary runtime checks; x-maxUtf8Bytes is an annotation."
}
