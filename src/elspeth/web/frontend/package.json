{
  "name": "elspeth-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "postbuild": "node scripts/prune-stale-assets.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.oidc.json --noEmit",
    "typecheck:workspace-e2e": "tsc -p tsconfig.workspace-e2e.json --noEmit",
    "lint": "eslint src vite.config.ts playwright.oidc.config.ts tests/e2e/aws-ecs-oidc.staging.spec.ts tests/e2e/harness/oidc-*.ts tests/e2e/composer-workspace-*.spec.ts tests/e2e/composer-workspace.visual.spec.ts tests/e2e/composer-reflow.spec.ts tests/e2e/helpers/api.ts tests/e2e/helpers/workspace-*.ts tests/e2e/page-objects/composer-page.ts",
    "lint:css": "stylelint 'src/**/*.css'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:oidc": "playwright test --config=playwright.oidc.config.ts",
    "test:e2e:staging": "playwright test --config=playwright.staging.config.ts tutorial-reliability.staging",
    "test:e2e:staging:smoke": "playwright test --config=playwright.staging.config.ts release-smoke.staging",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "staging:tutorial-harness": "node scripts/staging-tutorial-harness.mjs",
    "generate-types": "openapi-typescript http://localhost:8000/openapi.json -o src/types/api.generated.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@xyflow/react": "^12.11.6",
    "dompurify": "^3.4.15",
    "mermaid": "^11.17.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/dompurify": "^3.2.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.11.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "undici": "6.28.0"
    }
  }
}
