# Runtime data, databases, example outputs
# ---------------------------------------------------------------------------
/runs/
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
landscape.db-shm
landscape.db-wal
*.journal.jsonl
state/
data/*
