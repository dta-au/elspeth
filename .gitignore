!data/skills/
!data/skills/.gitignore
!data/skills/*.example
real/
examples/retention_purge/payloads/*
examples/**/output/*
examples/**/runs/*
examples/**/chroma_data/*
!examples/*/output/
!examples/*/runs/
!examples/*/output/.gitkeep
!examples/*/runs/.gitkeep
test-results.txt
instantiation-*.txt

# ---------------------------------------------------------------------------
# Deployment — support artefacts are tracked; operator-local values and
# generated backups are not.
# ---------------------------------------------------------------------------
deploy/**/*.env
!deploy/**/*.env.example
deploy/**/*.local.yaml
deploy/**/*.local.yml
deploy/**/*.bak-*
deploy/Caddyfile
# Source-checkout development unit (host-specific paths); the portable unit is
# deploy/linux-systemd/elspeth-web.service.
/deploy/elspeth-web.service
.worktrees/

# ---------------------------------------------------------------------------
# Generated documents — pipeline source is tracked, outputs are not.
# ---------------------------------------------------------------------------
tools/pdf/out/
docs/assets/*.pdf
docs/release/pdf/*
!docs/release/pdf/*.typ
!docs/release/pdf/Makefile
!docs/release/pdf/README.md
!docs/release/pdf/build.sh
!docs/release/pdf/versions.lock
!docs/release/pdf/fonts/
docs/release/pdf/fonts/*
!docs/release/pdf/fonts/public-sans/
docs/release/pdf/fonts/public-sans/*
!docs/release/pdf/fonts/public-sans/LICENSE.md
!docs/release/pdf/fonts/public-sans/OFL.txt
!docs/release/pdf/fonts/public-sans/fonts/
docs/release/pdf/fonts/public-sans/fonts/*
!docs/release/pdf/fonts/public-sans/fonts/ttf/
!docs/release/pdf/fonts/public-sans/fonts/ttf/**
docs/release/pdf/out/
docs/release/pdf/output/

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# FINAL RULE: keep .gitkeep files everywhere (overrides earlier ignores).
!.gitkeep
