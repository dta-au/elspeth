# ---------------------------------------------------------------------------
# Credential-shaped filenames — refused in every directory (defence in depth;
# the pre-commit secret scan at scripts/git-hooks/ catches content).
# ---------------------------------------------------------------------------
**/jwt.txt
**/jwt-*.txt
**/jwt_*.txt
**/*.api_key
**/*.access_token
**/*.bearer_token
**/login.json
**/login_*.json
**/*.pem
**/*.p12
**/*.pfx
**/.env
**/.env.*
!**/.env.example
!**/.env.template
!**/.env.sample
.env.local
.env.*.local
secrets/
!src/elspeth/**/secrets/
!tests/**/secrets/
credentials.json
*.key
!deploy/aws-ecs/trust/global-bundle.pem

# ---------------------------------------------------------------------------
# Internal working state — never public.
# ---------------------------------------------------------------------------
# Engineering memos, session logs, scratch records. Design notes that code or
# ADRs cite belong in docs/architecture/design-notes/ instead.
notes/
# Superpowers brainstorming artifacts.
.superpowers/
# Composer MCP scratch folder (session state, test configs).
.scratch/*
!.scratch/.gitkeep
scratch/
# Operator-local deployment/acceptance utilities (account-specific identifiers).
/ops-local/
# Throwaway repro tests for agent sessions; whole-tree gates subtract
# gitignored files (tests/helpers/tree_gate.py), so scratch cannot skew them.
/tests/_scratch/
# Project-control registers (PCR, T&M, RAID, milestone/forecast) are kept
# locally in full and are not published; only the folder README is tracked.
docs/project-control/*
!docs/project-control/README.md
# Generated bug-analysis docs and model-authored raw review findings.
docs/bugs/generated/
/docs/quality-audit/findings-panel-raw/
docs/audit/triage/
docs-archive/
# Local debugging screenshots.
/images/

# ---------------------------------------------------------------------------
# Agent / IDE tooling — tracked project guidance stays under .claude/ and
# .agents/; only the machine-local subpaths named here are ignored.
# ---------------------------------------------------------------------------
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/plans/
.claude/lanes/
.claude/handovers/
.claude/red-team/
.mcp.json
!.mcp.json.example
.codex
.antigravitycli/
.idea/
.vscode/
*.swp
*.swo
*~
.playwright-mcp/
.playwright-cli/
output/playwright/
# Codex CLI drops a routine ./error.log in its working dir.
error.log
# Filigree issue tracker.
.filigree/
# Loomweave (installer-written instance state and generated skill copies).
.loomweave/loomweave.lock
.loomweave/.gitignore
.loomweave/config.json
.loomweave/instance_id
loomweave.yaml
.agents/skills/loomweave-workflow/.fingerprint
.agents/skills/loomweave-workflow/SKILL.md
.claude/skills/loomweave-workflow/.fingerprint
.claude/skills/loomweave-workflow/SKILL.md
# Retired tooling residue (ADR-043).
.weft/

# ---------------------------------------------------------------------------
# elspeth-lints operator-local state
# ---------------------------------------------------------------------------
# .elspeth/rotations.log is deliberately tracked: it is the tier-model
# rotation audit trail that `elspeth-lints check-rotation-audit` verifies.
.elspeth/*
!.elspeth/rotations.log
.judge-metrics/
config/cicd/.sign-bundle-transactions/
# Reaudit crash-recovery sidecars (elspeth_lints/core/reaudit_sidecar.py).
**/.reaudit-state/
# atomic_write_text lock siblings (elspeth_lints/core/atomic_io.py).
config/cicd/**/.*.lock

# ---------------------------------------------------------------------------
# evals/ — the eval library and the two tracked corpora ship; run records and
# harness output do not. Order matters: re-include the directory, then its
# contents, then re-apply the credential rules (last matching rule wins).
# ---------------------------------------------------------------------------
/evals/*
!/evals/__init__.py
!/evals/lib/
!/evals/composer-parity/
!/evals/composer-parity/**
/evals/composer-parity/**/jwt.txt
/evals/composer-parity/**/jwt-*.txt
/evals/composer-parity/**/jwt_*.txt
/evals/composer-parity/**/*.api_key
/evals/composer-parity/**/*.access_token
/evals/composer-parity/**/*.bearer_token
/evals/composer-parity/**/login.json
/evals/composer-parity/**/login_*.json
/evals/composer-parity/**/*.pem
/evals/composer-parity/**/*.p12
/evals/composer-parity/**/*.pfx
/evals/composer-parity/**/.env
/evals/composer-parity/**/.env.*
!/evals/composer-parity/**/.env.example
!/evals/composer-parity/**/.env.template
!/evals/composer-parity/**/.env.sample
!/evals/composer-battery/
!/evals/composer-battery/**
/evals/composer-battery/runs/
/evals/composer-battery/**/jwt.txt
/evals/composer-battery/**/jwt-*.txt
/evals/composer-battery/**/jwt_*.txt
/evals/composer-battery/**/*.api_key
/evals/composer-battery/**/*.access_token
/evals/composer-battery/**/*.bearer_token
/evals/composer-battery/**/login.json
/evals/composer-battery/**/login_*.json
/evals/composer-battery/**/credentials.json
/evals/composer-battery/**/*.pem
/evals/composer-battery/**/*.p12
/evals/composer-battery/**/*.pfx
/evals/composer-battery/**/.env
/evals/composer-battery/**/.env.*
!/evals/composer-battery/**/.env.example
!/evals/composer-battery/**/.env.template
!/evals/composer-battery/**/.env.sample

