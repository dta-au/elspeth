+def render_planner_system_prompt(data_dir: str | None = None) -> str:
+    """Render the proposal planner's prompt: capability core + planner overlay.
+
+    The planner (and its escape hatch) offers only read-only discovery, the
+    recovery controls and ``emit_pipeline_proposal``; the freeform tool-loop
+    interaction policy teaches tools it cannot call. The deployment overlay
+    is appended exactly as for the tool loop.
+    """
+    core = render_with_pipeline_capabilities(_PIPELINE_PLANNER_SKILL)
+    deployment = load_deployment_skill("pipeline_composer", data_dir)
+    if deployment:
+        return core + "\n\n---\n\n" + deployment
+    return core
