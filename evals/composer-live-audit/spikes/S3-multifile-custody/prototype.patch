+    loop_state = _empty_state()
+    for name in ("q1", "q2"):
+        authored = pipeline["sources"][name]
+        result = execute_tool(
+            "set_source_from_blob",
+            {
+                "blob_id": authored["blob_id"],
+                "source_name": name,
+                "plugin": authored["plugin"],
+                "on_success": authored["on_success"],
+                "on_validation_failure": authored["on_validation_failure"],
+                "options": deepcopy(authored["options"]),
+            },
+            loop_state,
+            context.catalog,
+            plugin_snapshot=context.plugin_snapshot,
+            data_dir=context.data_dir,
+            session_engine=engine,
+            session_id=session_id,
+        )
+        assert result.success, result.to_dict()
+        loop_state = result.updated_state
+
+    for name in ("q1", "q2"):
+        assert planner_state.sources[name].plugin == loop_state.sources[name].plugin
+        assert planner_state.sources[name].on_success == loop_state.sources[name].on_success
+        assert planner_state.sources[name].on_validation_failure == loop_state.sources[name].on_validation_failure
+        assert planner_state.sources[name].options == loop_state.sources[name].options
