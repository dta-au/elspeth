diff --git a/tests/unit/web/composer/test_named_sources_blob_binding.py b/tests/unit/web/composer/test_named_sources_blob_binding.py
new file mode 100644
index 00000000..458ebb98
--- /dev/null
+++ b/tests/unit/web/composer/test_named_sources_blob_binding.py
@@ -0,0 +1,483 @@
+"""Named ``sources.<name>.blob_id`` binds uploaded blobs through the existing resolver.
+
+Spike S3 (composer desk audit 2026-11-12, finding F1, lane CDA-13). The
+pipeline document below is the exact proposal DeepSeek authored in the live
+s10 capture (turn 1, seq 12) — two uploaded quarters, a per-row ``quarter``
+literal, a queue fan-in and one CSV sink — with the live blob ids replaced by
+this test's blobs. On the base tree it is rejected at the canonical schema
+(``sources/item additionalProperties``).
+"""
+
+from __future__ import annotations
+
+import asyncio
+from copy import deepcopy
+from datetime import UTC, datetime
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+from uuid import UUID, uuid4
+
+import pytest
+from sqlalchemy import insert
+from sqlalchemy.pool import StaticPool
+
+from elspeth.contracts.blobs import BlobRecord
+from elspeth.contracts.composer_interpretation import InterpretationKind
+from elspeth.contracts.session_operation import SessionOperationKind
+from elspeth.web.blobs.service import BlobServiceImpl
+from elspeth.web.catalog.policy_view import PolicyCatalogView
+from elspeth.web.composer import yaml_generator
+from elspeth.web.composer.pipeline_proposal import reviewed_anchor_hash
+from elspeth.web.composer.protocol import ToolArgumentError
+from elspeth.web.composer.reviewed_source_authority import resolve_reviewed_source_authority
+from elspeth.web.composer.state import CompositionState, PipelineMetadata
+from elspeth.web.composer.tools import ToolContext, build_set_pipeline_candidate, execute_tool
+from elspeth.web.composer.tools._common import _serialize_set_pipeline_arguments
+from elspeth.web.composer.tools.blobs import _execute_create_blob
+from elspeth.web.composer.tools.schema_contract import canonical_set_pipeline_schema
+from elspeth.web.dependencies import create_catalog_service
+from elspeth.web.execution.validation import validate_pipeline_for_trained_operator
+from elspeth.web.interpretation_state import interpretation_sites
+from elspeth.web.plugin_policy.models import PluginAvailabilitySnapshot
+from elspeth.web.sessions.engine import create_session_engine
+from elspeth.web.sessions.models import chat_messages_table, sessions_table
+from elspeth.web.sessions.proposal_blob_refs import proposal_blob_reference_ids, validate_proposal_blob_references
+from elspeth.web.sessions.schema import initialize_session_schema
+from tests.fixtures.identities import ensure_test_identity
+from tests.helpers.composer_fences import fenced_tool_context
+from tests.helpers.session_fences import fenced_operation_context
+
+Q1 = b"invoice,supplier,amount\nQ1-001,Globex,5261.07\nQ1-002,Globex,711.99\nQ1-003,Acme,8507.66\n"
+Q2 = b"invoice,supplier,amount\nQ2-001,Globex,7994.66\nQ2-002,Globex,300.81\n"
+
+
+def _s10_pipeline(q1_blob_id: str, q2_blob_id: str) -> dict[str, Any]:
+    """The live s10 turn-1 seq-12 proposal, blob ids substituted."""
+    tag_schema = {
+        "fields": ["invoice: str", "supplier: str", "amount: str", "quarter: str"],
+        "guaranteed_fields": ["invoice", "supplier", "amount", "quarter"],
+        "mode": "flexible",
+    }
+    source_schema = {"fields": ["invoice: str", "supplier: str", "amount: str"], "mode": "flexible"}
+    return {
+        "edges": [],
+        "metadata": {
+            "description": "Combine the uploaded Q1 and Q2 invoice files into one CSV, tagging each row with the quarter it came from.",
+            "name": "Combined quarterly invoices",
+        },
+        "nodes": [
+            {
+                "description": "Tag each Q1 row with its quarter.",
+                "id": "tag_q1",
+                "input": "q1_rows",
+                "node_type": "transform",
+                "on_error": "discard",
+                "on_success": "combined",
+                "options": {"operations": [{"expression": "'Q1'", "target": "quarter"}], "schema": deepcopy(tag_schema)},
+                "plugin": "value_transform",
+            },
+            {
+                "description": "Tag each Q2 row with its quarter.",
+                "id": "tag_q2",
+                "input": "q2_rows",
+                "node_type": "transform",
+                "on_error": "discard",
+                "on_success": "combined",
+                "options": {"operations": [{"expression": "'Q2'", "target": "quarter"}], "schema": deepcopy(tag_schema)},
+                "plugin": "value_transform",
+            },
+            {
+                "description": "Gather the tagged Q1 and Q2 rows into one shared stream.",
+                "id": "combined",
+                "input": "combined",
+                "node_type": "queue",
+            },
+        ],
+        "outputs": [
+            {
+                "description": "Write the combined Q1 and Q2 rows to one CSV file.",
+                "on_write_failure": "discard",
+                "options": {
+                    "collision_policy": "auto_increment",
+                    "delimiter": ",",
+                    "encoding": "utf-8",
+                    "mode": "write",
+                    "path": "outputs/combined_quarters.csv",
+                    "schema": {"fields": ["invoice: str", "supplier: str", "amount: str", "quarter: str"], "mode": "fixed"},
+                },
+                "plugin": "csv",
+                "sink_name": "combined",
+            }
+        ],
+        "sources": {
+            "q1": {
+                "blob_id": q1_blob_id,
+                "description": "Load the Q1 invoice rows uploaded as q1.csv.",
+                "on_success": "q1_rows",
+                "on_validation_failure": "discard",
+                "options": {"schema": deepcopy(source_schema)},
+                "plugin": "csv",
+            },
+            "q2": {
+                "blob_id": q2_blob_id,
+                "description": "Load the Q2 invoice rows uploaded as q2.csv.",
+                "on_success": "q2_rows",
+                "on_validation_failure": "discard",
+                "options": {"schema": deepcopy(source_schema)},
+                "plugin": "csv",
+            },
+        },
+    }
+
+
+def _errors(candidate: Any) -> list[tuple[str | None, str | None, str]]:
+    return [(entry.error_code, entry.rejected_component, entry.message) for entry in candidate.result.validation.errors]
+
+
+def _empty_state() -> CompositionState:
+    return CompositionState(source=None, nodes=(), edges=(), outputs=(), metadata=PipelineMetadata(), version=1)
+
+
+def _engine_with_sessions(*session_ids: str) -> Any:
+    engine = create_session_engine("sqlite:///:memory:", poolclass=StaticPool, connect_args={"check_same_thread": False})
+    initialize_session_schema(engine)
+    now = datetime.now(UTC)
+    with engine.begin() as conn:
+        ensure_test_identity(conn, identity_id="s3-user")
+        for session_id in session_ids:
+            conn.execute(
+                insert(sessions_table).values(
+                    id=session_id, user_id="s3-user", auth_provider_type="local", title="s3", created_at=now, updated_at=now
+                )
+            )
+    return engine
+
+
+def _upload(engine: Any, data_dir: Path, session_id: str, filename: str, content: bytes) -> BlobRecord:
+    service = BlobServiceImpl(engine, data_dir)
+    with fenced_operation_context(engine, session_id, operation_kind=SessionOperationKind.CREATE) as operation_context:
+        return asyncio.run(
+            service.create_blob(UUID(session_id), filename, content, "text/csv", session_operation_context=operation_context)
+        )
+
+
+def _context(data_dir: Path, engine: Any, session_id: str, **kwargs: Any) -> ToolContext:
+    catalog = create_catalog_service()
+    snapshot = PluginAvailabilitySnapshot.for_trained_operator(catalog)
+    return ToolContext(
+        catalog=PolicyCatalogView.for_trained_operator(catalog, snapshot),
+        plugin_snapshot=snapshot,
+        data_dir=str(data_dir),
+        session_engine=engine,
+        session_id=session_id,
+        **kwargs,
+    )
+
+
+@pytest.fixture
+def two_uploads(tmp_path: Path) -> tuple[Any, str, BlobRecord, BlobRecord]:
+    session_id = str(uuid4())
+    engine = _engine_with_sessions(session_id)
+    q1 = _upload(engine, tmp_path, session_id, "q1.csv", Q1)
+    q2 = _upload(engine, tmp_path, session_id, "q2.csv", Q2)
+    return engine, session_id, q1, q2
+
+
+# --- (0) schema surface ------------------------------------------------------
+
+
+def test_canonical_named_source_schema_admits_blob_id_but_not_inline_blob() -> None:
+    named = canonical_set_pipeline_schema()["properties"]["sources"]["additionalProperties"]
+    assert named["additionalProperties"] is False
+    assert "blob_id" in named["properties"]
+    assert "inline_blob" not in named["properties"]
+
+
+# --- (1) the s10 document builds and passes the runtime preflight ------------
+
+
+def test_verbatim_s10_document_now_fails_only_on_ordinary_graph_naming(tmp_path: Path, two_uploads: Any) -> None:
+    """Custody settles; what remains is the model's queue/sink name collision, which the repair loop names."""
+    engine, session_id, q1, q2 = two_uploads
+    candidate = build_set_pipeline_candidate(_s10_pipeline(str(q1.id), str(q2.id)), _empty_state(), _context(tmp_path, engine, session_id))
+    assert sorted(code for code, _component, _message in _errors(candidate)) == [
+        "connection_sink_name_overlap",
+        "node_id_collides_with_source_or_sink",
+        "queue_no_consumer",
+    ]
+
+
+def _direct_fan_in(pipeline: dict[str, Any]) -> dict[str, Any]:
+    """Repair 1: drop the queue; both tag transforms publish straight to the sink."""
+    pipeline["nodes"] = [node for node in pipeline["nodes"] if node["node_type"] != "queue"]
+    return pipeline
+
+
+def _queue_fan_in(pipeline: dict[str, Any]) -> dict[str, Any]:
+    """Repair 2: keep an explicit queue, consumed by a passthrough that feeds the sink."""
+    for node in pipeline["nodes"]:
+        if node["node_type"] == "transform":
+            node["on_success"] = "all_quarters"
+        if node["node_type"] == "queue":
+            node.update(id="all_quarters", input="all_quarters")
+    pipeline["nodes"].append(
+        {
+            "id": "write_all",
+            "node_type": "transform",
+            "plugin": "passthrough",
+            "input": "all_quarters",
+            "on_success": "combined",
+            "on_error": "discard",
+            "options": {"schema": {"mode": "observed"}},
+        }
+    )
+    return pipeline
+
+
+@pytest.mark.parametrize("repair", [_direct_fan_in, _queue_fan_in], ids=["direct", "queue"])
+def test_s10_two_uploaded_quarters_build_and_pass_runtime_preflight(tmp_path: Path, two_uploads: Any, repair: Any) -> None:
+    engine, session_id, q1, q2 = two_uploads
+    pipeline = repair(_s10_pipeline(str(q1.id), str(q2.id)))
+    candidate = build_set_pipeline_candidate(pipeline, _empty_state(), _context(tmp_path, engine, session_id))
+
+    assert candidate.acceptable, _errors(candidate)
+    assert candidate.prepared_inline_blob is None
+    state = candidate.result.updated_state
+    for name, blob in (("q1", q1), ("q2", q2)):
+        options = state.sources[name].options
+        assert options["path"] == blob.storage_path
+        assert options["blob_ref"] == str(blob.id)
+        assert options["mode"] == "bind_source"
+    assert candidate.result.data["named_source_blobs"]["q2"]["blob_id"] == str(q2.id)
+
+    records = {q1.id: (q1, Q1), q2.id: (q2, Q2)}
+
+    result = validate_pipeline_for_trained_operator(
+        state,
+        SimpleNamespace(data_dir=tmp_path),
+        yaml_generator,
+        blob_get_metadata=lambda blob_id: records[blob_id][0] if blob_id in records else None,
+        blob_get_content=lambda blob_id: records[blob_id],
+        session_id=session_id,
+    )
+    assert result.is_valid, result.errors
+
