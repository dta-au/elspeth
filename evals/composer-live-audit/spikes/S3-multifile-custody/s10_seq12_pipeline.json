   "options": {
    "operations": [
     {
      "expression": "'Q2'",
      "target": "quarter"
     }
    ],
    "schema": {
     "fields": [
      "invoice: str",
      "supplier: str",
      "amount: str",
      "quarter: str"
     ],
     "guaranteed_fields": [
      "invoice",
      "supplier",
      "amount",
      "quarter"
     ],
     "mode": "flexible"
    }
   },
   "plugin": "value_transform"
  },
  {
   "description": "Gather the tagged Q1 and Q2 rows into one shared stream.",
   "id": "combined",
   "input": "combined",
   "node_type": "queue"
  }
 ],
 "outputs": [
  {
   "description": "Write the combined Q1 and Q2 rows to one CSV file.",
