    "delimiter": ",",
    "encoding": "utf-8",
    "mode": "write",
    "path": "outputs/combined_quarters.csv",
    "schema": {
     "fields": [
      "invoice: str",
      "supplier: str",
      "amount: str",
      "quarter: str"
     ],
     "mode": "fixed"
    }
   },
   "plugin": "csv",
   "sink_name": "combined"
  }
 ],
