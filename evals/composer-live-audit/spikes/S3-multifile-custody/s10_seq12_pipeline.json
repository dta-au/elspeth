   "on_success": "combined",
   "options": {
    "operations": [
     {
      "expression": "'Q1'",
      "target": "quarter"
     }
    ],
    "schema": {
     "fields": [
      "invoice: str",
      "supplier: str",
      "amount: str",
      "quarter: str"
     ],
     "guaranteed_fields": [
      "invoice",
      "supplier",
      "amount",
      "quarter"
     ],
     "mode": "flexible"
    }
   },
   "plugin": "value_transform"
  },
  {
   "description": "Tag each Q2 row with its quarter.",
